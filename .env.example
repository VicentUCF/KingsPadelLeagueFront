# URL pública del backend utilizada exclusivamente durante la build SSG.
KPL_API_BASE_URL=https://kings-league-api.esteveep.dev
# Dominio público final. Se usa en canonical, sitemap, Open Graph y datos estructurados.
KPL_SITE_URL=https://kingspadelleague.com

# Activar cuando todos los endpoints públicos de playoffs respondan sin autenticación.
KPL_PLAYOFFS_ENABLED=false

# URL del panel de jugadores/presidentes (subdominio, fuera de este cliente).
# Déjala sin definir mientras el panel no esté publicado: el enlace del
# header no aparece.
# KPL_PORTAL_URL=https://portal.kingspadelleague.com

# TinaCMS / TinaCloud — panel de noticias en /admin (ver tina/config.ts y README).
# Se crean en app.tina.io, en el proyecto conectado a este repositorio de GitHub.
TINA_CLIENT_ID=
TINA_TOKEN=
TINA_BRANCH=main
# Secreto propio (una cadena aleatoria larga) que autoriza previsualizar en producción una
# noticia con "Publicada" desactivada, vía /noticias/preview/<slug>?token=<este valor>. No es
# una autenticación real: solo evita que la URL de borrador sea adivinable o indexable. El
# prefijo TINA_PUBLIC_ es obligatorio: es lo único que TinaCMS inyecta en el bundle de /admin
# (ver tina/config.ts, `ui.router`), donde se construye el enlace "Ver en directo".
TINA_PUBLIC_PREVIEW_SECRET=
