---
import type { PublicPlayer, PublicTeam } from '../lib/public-league';
import { teamThemeStyle } from '../lib/team-identity';

interface Props {
	player: PublicPlayer;
	team?: PublicTeam;
	compact?: boolean;
	preseason?: boolean;
	rosterRole?: 'president' | 'player';
}

const { player, team, compact = false, preseason = false, rosterRole } = Astro.props;
const cardStyle = team ? teamThemeStyle(team) : undefined;
const fullName = [player.firstName, player.lastName].filter(Boolean).join(' ');
const secondaryIdentity = player.alias
	? `“${player.alias}” · ${player.positionLabel}`
	: player.positionLabel;
const rosterSecondaryIdentity = player.alias ? `“${player.alias}”` : null;
---

<a
	class:list={[
		'player-card',
		compact && 'player-card--compact',
		preseason && 'player-card--preseason',
		team && 'player-card--team',
		rosterRole && 'player-card--roster',
		rosterRole === 'president' && 'player-card--president',
		rosterRole === 'player' && 'player-card--squad-player',
	]}
	href={`/jugadores/${player.slug}`}
	style={cardStyle}
	data-player-card
	data-name={`${fullName} ${player.alias ?? ''}`.toLocaleLowerCase('es')}
	data-team={player.teamId ?? ''}
	data-side={player.preferredPosition}
>
	{team && <span class="player-card__team-accent" aria-hidden="true" />}
	<span class="player-card__topline">
		<span>{player.isPresident ? 'Presidencia' : player.positionLabel}</span>
		{!rosterRole && <span>{preseason ? 'T2' : `#${player.rank}`}</span>}
	</span>

	<span class="player-card__avatar" aria-hidden="true">
		<span class="player-card__avatar-glow"></span>
		{
			player.profileImage ? (
				<>
					{rosterRole && (
						<img
							class="player-card__avatar-backdrop"
							src={player.profileImage}
							alt=""
							aria-hidden="true"
							width="320"
							height="380"
							loading="lazy"
							decoding="async"
						/>
					)}
					<img
						class:list={[
							'player-card__avatar-image',
							rosterRole && 'player-card__avatar-image--roster',
						]}
						src={player.profileImage}
						alt=""
						width="320"
						height="380"
						loading="lazy"
						decoding="async"
						transition:name={`kpl-player-${player.slug}-portrait`}
					/>
				</>
			) : (
				<span
					class="player-card__placeholder"
					transition:name={`kpl-player-${player.slug}-portrait`}
				>
					{team && (
						<span class="player-card__placeholder-mark">
							{team.logoPath ? (
								<img src={team.logoPath} alt="" width="120" height="120" decoding="async" />
							) : (
								team.monogram
							)}
						</span>
					)}
					<svg viewBox="0 0 64 64" focusable="false">
						<circle cx="32" cy="23" r="10" />
						<path d="M13 53c2.5-11.5 9-17 19-17s16.5 5.5 19 17" />
					</svg>
					<strong>
						{player.firstName[0]}
						{player.lastName[0]}
					</strong>
				</span>
			)
		}
	</span>

	<span class="player-card__identity">
		{!rosterRole && <small>{player.teamName}</small>}
		<strong transition:name={`kpl-player-${player.slug}-name`}>{fullName}</strong>
		{
			rosterRole ? (
				rosterSecondaryIdentity && <span>{rosterSecondaryIdentity}</span>
			) : (
				<span>
					{secondaryIdentity}
					{player.isPresident ? ' · Presidente' : ''}
				</span>
			)
		}
	</span>

	{
		rosterRole ? null : preseason ? (
			<span class="player-card__preseason-note">
				<small>Temporada 2</small>
				<strong>Jugador confirmado</strong>
			</span>
		) : (
			<span class="player-card__stats" aria-label="Estadísticas de temporada">
				<span>
					<strong>{player.totalPoints}</strong>
					<small>PTS</small>
				</span>
				<span>
					<strong>{player.wonGames}</strong>
					<small>V</small>
				</span>
				<span>
					<strong>{player.lostGames}</strong>
					<small>D</small>
				</span>
			</span>
		)
	}

	<span class="player-card__cta">
		Ver perfil
		<span aria-hidden="true">↗</span>
	</span>
</a>
