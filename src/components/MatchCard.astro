---
import type { PublicEncounter } from '../lib/public-league';
import TeamBadge from './TeamBadge.astro';

interface Props {
	encounter: PublicEncounter;
	matchdayHref?: string;
	showPairs?: boolean;
}

const { encounter, matchdayHref, showPairs = false } = Astro.props;
const labels = {
	completed: 'Finalizado',
	current: 'En juego',
	upcoming: 'Programado',
} as const;
---

<article class="match-card c-match-card" data-status={encounter.status}>
	<header class="c-match-card__header">
		<span
			class:list={[
				'c-chip',
				encounter.status === 'current'
					? 'c-chip--tone-warning'
					: encounter.status === 'completed'
						? 'c-chip--tone-success'
						: 'c-chip--tone-info',
			]}
		>
			{labels[encounter.status]}
		</span>
		<time datetime={encounter.scheduledAt}>{encounter.scheduledAtLabel}</time>
	</header>
	<div class="c-match-card__teams">
		<div class="c-match-card__team"><TeamBadge team={encounter.homeTeam} meta="Local" /></div>
		<strong class="c-score" aria-label={`${encounter.homeScore} a ${encounter.awayScore}`}>
			<span>{encounter.homeScore}</span><span class="c-score__separator">:</span><span
				>{encounter.awayScore}</span
			>
		</strong>
		<div class="c-match-card__team match-card__away">
			<TeamBadge team={encounter.awayTeam} meta="Visitante" />
		</div>
	</div>
	{
		showPairs && encounter.pairResults.length > 0 && (
			<div class="match-card__pairs">
				{encounter.pairResults.map((pair) => (
					<div class="match-card__pair">
						<span>{pair.homePair.players.map((player) => player.displayName).join(' / ')}</span>
						<strong>{pair.homeScoreLabel}</strong>
						<span>{pair.awayPair.players.map((player) => player.displayName).join(' / ')}</span>
					</div>
				))}
			</div>
		)
	}
	{
		matchdayHref && (
			<footer class="c-match-card__footer">
				<span class="c-match-card__meta">Resultado oficial</span>
				<a class="c-button c-button--ghost c-button--sm" href={matchdayHref}>
					Ver jornada →
				</a>
			</footer>
		)
	}
</article>
