---
interface Props {
	eyebrow: string;
	title: string;
	description: string;
	meta?: string[];
	mark?: string;
	titleTransitionName?: string;
}

const { eyebrow, title, description, meta = [], mark = 'KPL', titleTransitionName } = Astro.props;
---

<header class="page-hero c-page-header">
	<span class="page-hero__mark" aria-hidden="true">{mark}</span>
	<span class="page-hero__court" aria-hidden="true"></span>
	<div class="c-page-header__copy">
		<p class="c-page-header__eyebrow">{eyebrow}</p>
		{
			titleTransitionName ? (
				<h1 transition:name={titleTransitionName}>{title}</h1>
			) : (
				<h1>{title}</h1>
			)
		}
		<p class="c-page-header__description">{description}</p>
		{
			meta.length > 0 && (
				<p class="page-hero__meta">
					{meta.map((item) => (
						<span>{item}</span>
					))}
				</p>
			)
		}
	</div>
	<div class="c-page-header__actions"><slot name="actions" /></div>
</header>
