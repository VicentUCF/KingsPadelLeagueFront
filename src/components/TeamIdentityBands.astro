---
import type { PublicTeam } from '../lib/public-league';
import { teamThemeStyle } from '../lib/team-identity';

interface Props {
	homeTeam: PublicTeam;
	awayTeam: PublicTeam;
}

const { homeTeam, awayTeam } = Astro.props;
---

<span class="team-identity-bands" aria-hidden="true">
	<span class="team-identity-band team-identity-band--home" style={teamThemeStyle(homeTeam)}></span>
	<span class="team-identity-band team-identity-band--away" style={teamThemeStyle(awayTeam)}></span>
</span>
