---
import type { PairLineup, PublicPlayoffMatch } from '../lib/public-league';
import TeamBadge from './TeamBadge.astro';

interface Props {
	match: PublicPlayoffMatch;
}

const { match } = Astro.props;
const labels = {
	completed: 'Finalizado',
	current: 'En juego',
	upcoming: 'Programado',
} as const;
const scoreLabel =
	match.awayTeam && match.awayScore !== null
		? `${match.homeScore} a ${match.awayScore}`
		: 'Marcador pendiente';

function fullName(player: PairLineup['players'][number]) {
	return [player.firstName, player.lastName].filter(Boolean).join(' ');
}
---

<article class="playoff-match-card c-match-card" data-status={match.status}>
	<header class="c-match-card__header">
		<div class="o-cluster">
			<span class="c-chip c-chip--tone-brand">{match.stageLabel}</span>
			<span
				class:list={[
					'c-chip',
					match.status === 'current'
						? 'c-chip--tone-warning'
						: match.status === 'completed'
							? 'c-chip--tone-success'
							: 'c-chip--tone-info',
				]}
			>
				{labels[match.status]}
			</span>
		</div>
		<time datetime={match.scheduledAt}>{match.scheduledAtLabel}</time>
	</header>

	<div class="c-match-card__teams">
		<div class="c-match-card__team"><TeamBadge team={match.homeTeam} meta="Local" /></div>
		<strong class="c-score" aria-label={scoreLabel}>
			<span>{match.homeScore}</span><span class="c-score__separator">:</span><span
				>{match.awayScore ?? '—'}</span
			>
		</strong>
		<div class="c-match-card__team">
			{
				match.awayTeam ? (
					<TeamBadge team={match.awayTeam} meta="Visitante" />
				) : (
					<div class="playoff-match-card__pending">
						<span class="playoff-match-card__pending-mark">?</span>
						<span>
							<>
								<strong>Por determinar</strong>
								<small>Visitante</small>
							</>
						</span>
					</div>
				)
			}
		</div>
	</div>

	{
		match.pairResults.length > 0 && (
			<div class="match-card__pairs">
				{match.pairResults.map((pair) => {
					const homeWins = pair.winnerTeamId === match.homeTeam.id;
					const awayWins = match.awayTeam ? pair.winnerTeamId === match.awayTeam.id : false;
					return (
						<div class="match-card__pair">
							<p class="match-card__pair-label">{pair.label}</p>
							<div class="match-card__pair-row">
								<ul
									class="match-card__pair-players"
									data-result={homeWins ? 'win' : awayWins ? 'lose' : undefined}
								>
									{pair.homePair.players.map((player) => (
										<li>
											<a href={`/jugadores/${player.slug}`}>{fullName(player)}</a>
											{player.alias && <small>“{player.alias}”</small>}
										</li>
									))}
								</ul>
								<strong class="match-card__pair-score">{pair.homeScoreLabel}</strong>
								<ul
									class="match-card__pair-players match-card__pair-players--away"
									data-result={awayWins ? 'win' : homeWins ? 'lose' : undefined}
								>
									{pair.awayPair.players.map((player) => (
										<li>
											<a href={`/jugadores/${player.slug}`}>{fullName(player)}</a>
											{player.alias && <small>“{player.alias}”</small>}
										</li>
									))}
								</ul>
							</div>
						</div>
					);
				})}
			</div>
		)
	}
</article>
