---
import '@kpl/design-system/css';
import '../styles/site-shell.css';
import '../styles/page-shell.css';
import '../styles/team.css';
import '../styles/player.css';
import '../styles/calendar.css';
import '../styles/standings.css';
import '../styles/team-identity.css';
import { ClientRouter } from 'astro:transitions';
import type { TransitionDirectionalAnimations } from 'astro';
import { PLAYOFFS_ENABLED, PORTAL_URL } from '../lib/features';

interface Props {
	description?: string;
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
	pageType?: 'website' | 'profile' | 'article';
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
	title: string;
}

const {
	description = 'Resultados, clasificación, calendario, equipos y jugadores de Kings Padel League.',
	image = '/kpl-trophy.png',
	imageAlt = 'Trofeo de Kings Padel League',
	noindex = false,
	pageType = 'website',
	structuredData,
	title,
} = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalUrl = Astro.site ? new URL(currentPath, Astro.site) : null;
const socialImageUrl = new URL(image, Astro.site ?? Astro.url.origin);
const jsonLdItems = structuredData ? [structuredData].flat() : [];
const jsonLd = toJsonLdScript(jsonLdItems);
const navigation = [
	{ href: '/', label: 'Inicio' },
	{ href: '/noticias', label: 'Noticias' },
	{ href: '/clasificacion', label: 'Clasificación' },
	{ href: '/calendario', label: 'Calendario' },
	{ href: '/cartas', label: 'Cartas' },
	{ href: '/equipos', label: 'Equipos' },
	{ href: '/jugadores', label: 'Jugadores' },
	...(PLAYOFFS_ENABLED ? [{ href: '/playoffs', label: 'Playoffs' }] : []),
] as const;
const isCurrent = (href: string) =>
	href === '/' ? currentPath === href : currentPath === href || currentPath.startsWith(`${href}/`);
const pageTransition: TransitionDirectionalAnimations = {
	forwards: {
		old: {
			name: 'kpl-page-out-forward',
			duration: '120ms',
			easing: 'cubic-bezier(0.4, 0, 1, 1)',
			fillMode: 'both',
		},
		new: {
			name: 'kpl-page-in-forward',
			duration: '200ms',
			easing: 'cubic-bezier(0.2, 0, 0, 1)',
			fillMode: 'both',
		},
	},
	backwards: {
		old: {
			name: 'kpl-page-out-back',
			duration: '120ms',
			easing: 'cubic-bezier(0.4, 0, 1, 1)',
			fillMode: 'both',
		},
		new: {
			name: 'kpl-page-in-back',
			duration: '200ms',
			easing: 'cubic-bezier(0.2, 0, 0, 1)',
			fillMode: 'both',
		},
	},
};

function toJsonLdScript(items: Record<string, unknown>[]): string | null {
	if (items.length === 0) return null;
	const payload = items.length === 1 ? items[0] : items;
	return JSON.stringify(payload).replaceAll('<', '\\u003c');
}
---

<!doctype html>
<html lang="es" transition:name="root" transition:animate="none">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta
			name="robots"
			content={noindex
				? 'noindex, follow'
				: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
		/>
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#0b0b0b" />
		<meta name="color-scheme" content="dark" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="Kings Padel League" />
		<meta property="og:type" content={pageType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{canonicalUrl && <link rel="alternate" hreflang="es-ES" href={canonicalUrl} />}
		{Astro.site && <link rel="sitemap" href={new URL('/sitemap.xml', Astro.site)} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
		<ClientRouter fallback="none" />
	</head>
	<body data-kpl-root>
		<div class="kpl-nav-progress" id="kpl-nav-progress" aria-hidden="true"></div>
		<a class="c-skip-link u-visually-hidden-focusable" href="#main-content"> Ir al contenido </a>
		<header
			class="c-site-header site-shell__header"
			transition:name="site-header"
			transition:animate="none"
		>
			<div class="c-site-header__inner o-container">
				<a class="c-brand site-shell__brand" href="/" aria-label="Kings Padel League, inicio">
					<img
						class="site-shell__brand-image"
						src="/kpl-logo-wordmark.png"
						alt=""
						width="318"
						height="135"
						decoding="async"
					/>
					<span class="c-brand__copy">
						<span class="c-brand__name">Kings Padel League</span>
						<span class="c-brand__tagline">Temporada 2 · Liga amateur</span>
					</span>
				</a>

				<nav class="c-nav site-shell__desktop-nav" aria-label="Principal">
					{
						navigation.map((item) => (
							<a
								class="c-nav__link"
								href={item.href}
								aria-current={isCurrent(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>

				<div class="site-shell__actions">
					{
						PORTAL_URL && (
							<a class="c-button c-button--outline c-button--sm" href={PORTAL_URL} target="_blank">
								Área de jugadores
							</a>
						)
					}
					<details class="site-shell__menu">
						<summary
							class="site-shell__menu-toggle c-icon-button"
							aria-label="Abrir menú de navegación"
						>
							<span class="site-shell__burger" aria-hidden="true">
								<span class="site-shell__burger-bar"></span>
							</span>
						</summary>
						<nav class="site-shell__mobile-nav" aria-label="Principal móvil">
							{
								navigation.map((item) => (
									<a
										class="c-nav__link"
										href={item.href}
										aria-current={isCurrent(item.href) ? 'page' : undefined}
									>
										{item.label}
									</a>
								))
							}
						</nav>
					</details>
				</div>
			</div>
		</header>
		<div
			class="site-shell__page"
			transition:name="page-content"
			transition:animate={pageTransition}
		>
			<slot />
		</div>
		<footer class="site-shell__footer">
			<div class="site-shell__footer-inner o-container">
				<div class="site-shell__footer-brand">
					<strong>Kings Padel League</strong>
					<span>Resultados, calendario y protagonistas de la liga amateur de pádel</span>
				</div>
				<nav class="site-shell__footer-nav" aria-label="Pie de página">
					{navigation.slice(1).map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
			</div>
		</footer>
		<script>
			const prepareMainContent = (moveFocus = false) => {
				const main = document.querySelector<HTMLElement>('#main-content');
				if (!main) return;
				if (!main.hasAttribute('tabindex')) main.tabIndex = -1;
				// .focus() forces the browser to flush layout synchronously. Called
				// right after astro:after-swap, that means laying out the entire new
				// page (which hasn't been rendered yet at all) on the main thread,
				// right in the middle of the view transition's own paint/composite
				// work — measured as the single biggest source of jank during
				// navigation. Deferring one frame lets the browser's normal paint
				// happen first, so the layout .focus() needs is already done.
				if (moveFocus) requestAnimationFrame(() => main.focus({ preventScroll: true }));
			};

			document.addEventListener('astro:before-swap', (event) => {
				event.newDocument.body.dataset.kplClientNavigation = 'true';
			});
			document.addEventListener('astro:after-swap', () => prepareMainContent(true));
			document.addEventListener('astro:page-load', () => prepareMainContent());

			// If the view transition starts while the page is scrolled down, the
			// browser captures the "old" snapshot at that scroll offset and then the
			// swap resets scroll to 0 mid-flight. That mismatch between the two
			// snapshots produces a dropped/blank compositor frame right as the
			// transition begins — very visible as a black flash on slower mobile
			// GPUs. Scrolling to the top before the transition starts capturing
			// removes the mismatch entirely.
			document.addEventListener('astro:before-preparation', () => {
				if (window.scrollY > 0 || window.scrollX > 0) {
					window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
				}
			});

			// Astro's ClientRouter fetches the target page before it can start the
			// view transition. On mobile connections that fetch can take a moment
			// with no visible feedback, which reads as a stuck/broken tap. Fill that
			// gap with a thin progress bar, delayed slightly so fast navigations
			// (cached/local) never see it flash.
			const navProgress = document.querySelector<HTMLElement>('#kpl-nav-progress');
			let navProgressShowTimer: ReturnType<typeof setTimeout> | undefined;
			let navProgressHideTimer: ReturnType<typeof setTimeout> | undefined;

			document.addEventListener('astro:before-preparation', () => {
				if (!navProgress) return;
				clearTimeout(navProgressShowTimer);
				clearTimeout(navProgressHideTimer);
				navProgress.removeAttribute('data-state');
				navProgress.style.transform = 'scaleX(0)';
				navProgressShowTimer = setTimeout(() => {
					navProgress.setAttribute('data-active', '');
					requestAnimationFrame(() => {
						navProgress.style.transform = 'scaleX(0.7)';
					});
				}, 120);
			});

			document.addEventListener('astro:page-load', () => {
				if (!navProgress) return;
				clearTimeout(navProgressShowTimer);
				if (!navProgress.hasAttribute('data-active')) return;
				navProgress.setAttribute('data-state', 'done');
				navProgress.style.transform = 'scaleX(1)';
				navProgressHideTimer = setTimeout(() => {
					navProgress.removeAttribute('data-active');
					navProgress.removeAttribute('data-state');
					navProgress.style.transform = 'scaleX(0)';
				}, 300);
			});

			// <ClientRouter fallback="none" /> means browsers without the native
			// View Transitions API get a plain browser navigation for every link:
			// the tab just unloads and requests the next page, so none of the
			// astro:* lifecycle events above ever fire and the progress bar never
			// shows. That leaves an instant, feedback-less cut that reads as more
			// "tosco" than the animated path supported browsers get. Trigger the
			// same bar straight from the click instead, purely as a "something is
			// happening" cue — the browser's own navigation takes it from there.
			if (typeof document.startViewTransition !== 'function' && navProgress) {
				document.addEventListener(
					'click',
					(event) => {
						if (event.defaultPrevented || event.button !== 0) return;
						if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
						const target = event.target instanceof Element ? event.target : null;
						const link = target?.closest('a[href]');
						if (!(link instanceof HTMLAnchorElement)) return;
						if (link.target && link.target !== '_self') return;
						if (link.hasAttribute('download')) return;
						const url = new URL(link.href, location.href);
						if (url.origin !== location.origin) return;
						const sameDocument =
							url.pathname === location.pathname && url.search === location.search;
						if (sameDocument && url.hash) return;

						navProgress.setAttribute('data-active', '');
						navProgress.style.transform = 'scaleX(0)';
						requestAnimationFrame(() => {
							navProgress.style.transform = 'scaleX(0.85)';
						});
					},
					{ capture: true },
				);
			}

			const closeMobileMenu = (menu: HTMLDetailsElement, focusToggle = false) => {
				menu.removeAttribute('open');
				if (focusToggle) menu.querySelector('summary')?.focus();
			};

			document.addEventListener('click', (event) => {
				const target = event.target instanceof Element ? event.target : null;
				document.querySelectorAll<HTMLDetailsElement>('.site-shell__menu[open]').forEach((menu) => {
					const clickedLink = target?.closest('.site-shell__mobile-nav a');
					const clickedOutside = !!target && !menu.contains(target);
					if (clickedLink || clickedOutside) closeMobileMenu(menu);
				});
			});

			document.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape') return;
				document
					.querySelectorAll<HTMLDetailsElement>('.site-shell__menu[open]')
					.forEach((menu) => closeMobileMenu(menu, true));
			});
		</script>
	</body>
</html>
