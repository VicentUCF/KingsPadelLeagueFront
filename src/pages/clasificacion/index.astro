---
import PageHero from '../../components/PageHero.astro';
import TeamBadge from '../../components/TeamBadge.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	isPublicPreseason,
	PUBLIC_SEASON_NAME,
	SEASON_STARTS_LABEL,
} from '../../lib/league-presentation';
import { loadPublicLeagueView } from '../../lib/public-view';

const view = await loadPublicLeagueView();
const preseason = isPublicPreseason();
---

<BaseLayout
	title={`Clasificación · ${PUBLIC_SEASON_NAME} · Kings Padel League`}
	description={`Clasificación oficial de ${PUBLIC_SEASON_NAME} en Kings Padel League.`}
>
	<main id="main-content" class="public-page public-page--standings">
		<div class="o-container o-container--xl public-page__body">
			<PageHero
				eyebrow={`${PUBLIC_SEASON_NAME} · Clasificación`}
				title={preseason ? 'Todos empiezan desde cero' : 'La carrera por la corona'}
				description={preseason
					? 'La clasificación se activará con la primera jornada. Hasta entonces, la nueva parrilla comparte el mismo punto de partida.'
					: 'Puntos, partidos jugados y diferencia de juegos: la lectura más clara del pulso de la temporada.'}
				meta={preseason
					? ['Pretemporada', `${view.teams.length} equipos`, `Inicio · ${SEASON_STARTS_LABEL}`]
					: [
							PUBLIC_SEASON_NAME,
							view.focusMatchday?.label ?? 'Temporada en curso',
							view.phaseLabel,
						]}
				mark="#"
			>
				<a slot="actions" class="c-button c-button--primary" href="/equipos">Ver equipos</a>
				<a slot="actions" class="c-button c-button--outline" href="/jornadas">Jornadas</a>
			</PageHero>

			{
				preseason ? (
					<section class="standings-preseason" aria-labelledby="standings-preseason-title">
						<div class="standings-preseason__intro">
							<p class="c-eyebrow">Parrilla confirmada</p>
							<h2 id="standings-preseason-title">La tabla espera al primer punto.</h2>
							<p>
								No heredamos posiciones ni estadísticas anteriores. {PUBLIC_SEASON_NAME} empieza el{' '}
								{SEASON_STARTS_LABEL} con una clasificación limpia.
							</p>
							<div class="standings-preseason__key">
								<span>
									<>
										<strong>0</strong>
										<small>PTS</small>
									</>
								</span>
								<span>
									<>
										<strong>0</strong>
										<small>PJ</small>
									</>
								</span>
								<span>
									<>
										<strong>0</strong>
										<small>DIF.</small>
									</>
								</span>
							</div>
						</div>
						<ol class="standings-preseason__teams">
							{view.teams.map((team) => (
								<li>
									<span class="standings-preseason__rank">—</span>
									<TeamBadge team={team} />
									<span class="c-chip">Confirmado</span>
								</li>
							))}
						</ol>
					</section>
				) : (
					<section class="section-block standings-section" aria-labelledby="standings-title">
						<header class="section-block__header section-block__header--editorial">
							<div>
								<p class="c-eyebrow">Tabla oficial</p>
								<h2 id="standings-title">Clasificación general</h2>
							</div>
							<p>Ordenada por puntos oficiales y diferencia de juegos.</p>
						</header>
						<div class="c-table-wrap standings-table-wrap">
							<table class="c-table standings-table">
								<caption class="u-visually-hidden">Clasificación de {PUBLIC_SEASON_NAME}</caption>
								<thead>
									<tr>
										<>
											<th scope="col">Pos.</th>
											<th scope="col">Equipo</th>
											<th class="c-table__numeric" scope="col">
												PTS
											</th>
											<th class="c-table__numeric" scope="col">
												PJ
											</th>
											<th class="c-table__numeric" scope="col">
												Dif.
											</th>
										</>
									</tr>
								</thead>
								<tbody>
									{view.standings.map((standing) => (
										<tr>
											<td>
												<span class="c-rank" data-rank={standing.rank}>
													{standing.rank}
												</span>
											</td>
											<th scope="row">
												<TeamBadge team={standing.team} />
											</th>
											<td class="c-table__numeric">
												<strong>{standing.points}</strong>
											</td>
											<td class="c-table__numeric">{standing.playedMatches}</td>
											<td
												class:list={[
													'c-table__numeric',
													standing.gameDifference > 0 && 'standings-table__positive',
													standing.gameDifference < 0 && 'standings-table__negative',
												]}
											>
												{standing.gameDifference > 0 ? '+' : ''}
												{standing.gameDifference}
											</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</section>
				)
			}
		</div>
	</main>
</BaseLayout>
