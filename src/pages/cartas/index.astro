---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/cards-hero.css';
import '../../styles/cards-rules.css';
import '../../styles/cards-grid.css';

const levels = [
	{
		id: 'verde',
		name: 'Nivel verde',
		number: '01',
		tone: 'green',
		title: 'Ajustes tácticos',
		description:
			'Cartas para cambiar una decisión concreta sin alterar por completo el siguiente juego.',
		cards: [
			{
				id: 'restas-tu',
				name: 'Restas tú',
				image: '/cards/restas-tu.png',
				duration: 'Hasta el próximo punto de oro',
				activation: 'Entre juegos',
				effect: 'La pareja que activa la carta elige quién resta en el próximo punto de oro.',
			},
			{
				id: 'cambiate',
				name: 'Cámbiate',
				image: '/cards/cambiate.png',
				duration: '1 juego, al resto',
				activation: 'Entre juegos',
				effect: 'La pareja rival tiene que cambiar de lado durante el siguiente juego al resto.',
			},
		],
	},
	{
		id: 'azul',
		name: 'Nivel azul',
		number: '02',
		tone: 'blue',
		title: 'Presión al servicio',
		description:
			'Dos cartas que convierten el saque en una decisión estratégica durante el siguiente juego.',
		cards: [
			{
				id: 'robo-saque',
				name: 'Robo saque',
				image: '/cards/robo-saque.png',
				duration: '1 juego',
				activation: 'Entre juegos',
				effect: 'La pareja que activa la carta roba el saque a la pareja rival durante un juego.',
			},
			{
				id: 'solo-un-saque',
				name: 'Solo un saque',
				image: '/cards/solo-un-saque.png',
				duration: '1 juego, al resto',
				activation: 'Entre juegos',
				effect: 'La pareja rival juega sin segundo servicio durante el siguiente juego.',
			},
		],
	},
	{
		id: 'oro',
		name: 'Nivel oro',
		number: '03',
		tone: 'gold',
		title: 'Máximo impacto',
		description:
			'Las cartas capaces de provocar el giro más grande en el momento decisivo del partido.',
		cards: [
			{
				id: '2-vs-1',
				name: '2 vs 1',
				image: '/cards/2-vs-1.png',
				duration: '1 juego',
				activation: 'Entre juegos',
				effect:
					'La pareja que activa la carta juega con superioridad numérica y toda la pista disponible durante un juego.',
			},
			{
				id: 'comodin',
				name: 'Comodín',
				image: '/cards/comodin.png',
				duration: 'Canje inmediato',
				activation: 'Entre juegos',
				effect: 'Permite cambiarla por cualquier otra carta disponible en el maletín.',
			},
			{
				id: 'robo-carta',
				name: 'Robo carta',
				image: '/cards/robo-carta.png',
				duration: 'Uso único',
				activation: 'En respuesta al rival',
				effect: 'Solo puede canjearse cuando el equipo rival activa su carta.',
			},
		],
	},
] as const;

const toneLabels: Record<(typeof levels)[number]['tone'], string> = {
	green: 'verde',
	blue: 'azul',
	gold: 'oro',
};

const cards = levels.flatMap((level) =>
	level.cards.map((card) => ({ ...card, level: level.name })),
);
const cardsUrl = Astro.site ? new URL('/cartas', Astro.site).href : null;
const structuredData = cardsUrl
	? {
			'@context': 'https://schema.org',
			'@type': 'CollectionPage',
			name: 'Cartas de Kings Padel League',
			description:
				'Las siete cartas, sus niveles y las reglas para activarlas durante los partidos de Kings Padel League.',
			url: cardsUrl,
			mainEntity: {
				'@type': 'ItemList',
				itemListElement: cards.map((card, index) => ({
					'@type': 'ListItem',
					position: index + 1,
					name: card.name,
					description: card.effect,
					url: `${cardsUrl}#carta-${card.id}`,
				})),
			},
		}
	: undefined;
---

<BaseLayout
	title="Cartas de Kings Padel League: niveles, reglas y efectos"
	description="Las 7 cartas de Kings Padel League: niveles verde, azul y oro, su efecto en pista y el momento exacto en que cada presidente puede activarlas."
	image="/cards/2-vs-1.png"
	imageAlt="Carta 2 vs 1 de Kings Padel League"
	structuredData={structuredData}
>
	<main id="main-content" class="cards-page" tabindex="-1">
		<section class="cards-hero" aria-labelledby="cards-title">
			<div class="cards-hero__glow" aria-hidden="true"></div>
			<div class="cards-hero__inner o-container o-container--xl">
				<div class="cards-hero__copy">
					<p class="c-eyebrow">El factor sorpresa de Kings Padel League</p>
					<h1 id="cards-title">Siete cartas.<br /><span>Un giro de partido.</span></h1>
					<p class="cards-hero__lead">
						Antes de cada partido se abre el maletín y cada presidente roba una carta. Tiene una
						sola oportunidad para cambiar el guion desde la pista.
					</p>
					<div class="cards-hero__actions">
						<a class="c-button c-button--primary c-button--lg" href="#baraja">
							Descubrir las 7 cartas
							<span aria-hidden="true">↓</span>
						</a>
						<a class="c-button c-button--outline c-button--lg" href="#como-funciona">
							Cómo se juega
						</a>
					</div>
					<dl class="cards-hero__facts" aria-label="Datos de las cartas KPL">
						<div><dt>Maletín</dt><dd>Antes del partido</dd></div>
						<div><dt>Reparto</dt><dd>1 por presidente</dd></div>
						<div><dt>Activación</dt><dd>Un solo uso</dd></div>
					</dl>
				</div>
				<div class="cards-hero__animation" data-cards-animation aria-hidden="true">
					<div class="cards-hero__video-crop">
						<img
							class="cards-hero__case-poster"
							data-case-poster
							src="/images/kpl/kpl-reveal-final.webp"
							alt=""
							decoding="async"
						/>
						<canvas class="cards-hero__case-canvas" data-case-canvas hidden></canvas>
					</div>
				</div>
			</div>
		</section>

		<div class="cards-page__body o-container o-container--xl">
			<section id="como-funciona" class="cards-rules" aria-labelledby="rules-title">
				<header class="cards-section-heading">
					<div>
						<p class="c-eyebrow">Del maletín a la pista</p>
						<h2 id="rules-title">Cómo entran las cartas en juego.</h2>
					</div>
					<p>
						La carta añade estrategia sin interrumpir el ritmo natural del partido. El momento de
						activación forma parte de la regla.
					</p>
				</header>

				<ol class="cards-steps" aria-label="Funcionamiento de las cartas">
					<li>
						<span>01</span>
						<div>
							<strong>Se abre el maletín</strong><p>Siempre antes de empezar el partido.</p>
						</div>
					</li>
					<li>
						<span>02</span>
						<div>
							<strong>Cada <a href="/equipos">presidente</a> roba una</strong><p>
								Una carta al azar para su equipo.
							</p>
						</div>
					</li>
					<li>
						<span>03</span>
						<div>
							<strong>Se guarda el momento</strong><p>La carta solo puede utilizarse una vez.</p>
						</div>
					</li>
					<li>
						<span>04</span>
						<div>
							<strong>Se activa entre juegos</strong><p>Nunca mientras un juego está en curso.</p>
						</div>
					</li>
				</ol>

				<div
					class="cards-timing c-surface-card c-surface-card--accent"
					aria-labelledby="timing-title"
				>
					<div class="cards-timing__copy">
						<p class="c-eyebrow">La regla que no puede fallar</p>
						<h3 id="timing-title">Primero termina el juego. Después, juega tu carta.</h3>
						<p>
							Puede activarse justo después de cerrar un juego, también coincidiendo con un cambio
							de lado. La carta debe anunciarse antes de empezar el siguiente.
						</p>
					</div>
					<div class="cards-timing__examples">
						<div class="cards-timing__example cards-timing__example--yes">
							<span aria-hidden="true">✓</span>
							<div><strong>Sí se puede</strong><p>Con juegos cerrados: 1–0, 1–1, 2–1…</p></div>
						</div>
						<div class="cards-timing__example cards-timing__example--no">
							<span aria-hidden="true">×</span>
							<div><strong>No se puede</strong><p>En mitad de un juego: 40–15, 30–30…</p></div>
						</div>
					</div>
				</div>
			</section>

			<nav class="cards-level-nav" aria-label="Niveles de las cartas">
				<span class="cards-level-nav__label">Explora la baraja</span>
				{
					levels.map((level) => (
						<a href={`#nivel-${level.id}`} data-tone={level.tone}>
							<span>{level.number}</span>
							<strong>{level.name}</strong>
							<small>{level.cards.length} cartas</small>
						</a>
					))
				}
			</nav>

			<section id="baraja" class="cards-deck" aria-labelledby="deck-title">
				<header class="cards-section-heading cards-section-heading--deck">
					<div>
						<p class="c-eyebrow">La baraja completa</p>
						<h2 id="deck-title">Siete cartas. Siete formas de romper el guion.</h2>
					</div>
					<p>Cada color anticipa el tipo de ventaja. Abre cada nivel y prepara el momento.</p>
				</header>

				{
					levels.map((level) => (
						<section
							id={`nivel-${level.id}`}
							class="cards-level"
							data-tone={level.tone}
							aria-labelledby={`level-${level.id}-title`}
						>
							<header class="cards-level__header">
								<div class="cards-level__number" aria-hidden="true">
									{level.number}
								</div>
								<div>
									<p>{level.name}</p>
									<h3 id={`level-${level.id}-title`}>{level.title}</h3>
									<span>{level.description}</span>
								</div>
							</header>
							<div class="cards-grid o-grid">
								{level.cards.map((card) => (
									<article id={`carta-${card.id}`} class="action-card c-surface-card">
										<div class="action-card__visual">
											<img
												src={card.image}
												alt={`Carta ${card.name} de Kings Padel League, nivel ${toneLabels[level.tone]}`}
												width="447"
												height="559"
												loading="lazy"
												decoding="async"
											/>
										</div>
										<div class="action-card__body">
											<div class="action-card__heading">
												<span>{level.name}</span>
												<h4>{card.name}</h4>
											</div>
											<p class="action-card__effect">{card.effect}</p>
											<dl class="action-card__meta">
												<div>
													<dt>Duración</dt>
													<dd>{card.duration}</dd>
												</div>
												<div>
													<dt>Activación</dt>
													<dd>{card.activation}</dd>
												</div>
											</dl>
										</div>
									</article>
								))}
							</div>
						</section>
					))
				}
			</section>

			<aside
				class="cards-finale c-surface-card c-surface-card--accent"
				aria-labelledby="finale-title"
			>
				<div>
					<p class="c-eyebrow">La emoción también se juega</p>
					<h2 id="finale-title">La carta está en tu mano.<br />El momento lo eliges tú.</h2>
					<p>
						Sigue las jornadas para ver qué presidentes arriesgan, cuándo activan su ventaja y cómo
						responde la pista.
					</p>
				</div>
				<a class="c-button c-button--primary c-button--lg" href="/calendario">Ver el calendario</a>
			</aside>
		</div>
	</main>
</BaseLayout>

<script>
	import * as THREE from 'three';
	import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
	import { HDRLoader } from 'three/examples/jsm/loaders/HDRLoader.js';

	const MODEL_URL = '/models/kpl/kpl-reveal.glb';
	const ENVIRONMENT_URL = '/models/kpl/kpl-trophy-studio.hdr';
	const CLIP_NAME = 'KPL_Reveal';
	const RENDER_WIDTH = 1400;
	const RENDER_HEIGHT = 600;
	const CAMERA_ZOOM = 1.3;

	const initializeCardsAnimation = () => {
		document.querySelectorAll('[data-cards-animation]').forEach((animation) => {
			if (!(animation instanceof HTMLElement) || animation.dataset.ready === 'true') return;
			animation.dataset.ready = 'true';

			const canvas = animation.querySelector('[data-case-canvas]');
			const poster = animation.querySelector('[data-case-poster]');
			if (!(canvas instanceof HTMLCanvasElement) || !(poster instanceof HTMLImageElement)) return;

			const showStaticComposition = () => {
				animation.classList.remove('is-playing');
				animation.classList.add('is-static');
			};

			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
			renderer.setSize(RENDER_WIDTH, RENDER_HEIGHT, false);
			renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
			renderer.outputColorSpace = THREE.SRGBColorSpace;
			renderer.toneMapping = THREE.ACESFilmicToneMapping;

			const pmremGenerator = new THREE.PMREMGenerator(renderer);
			pmremGenerator.compileEquirectangularShader();

			const scene = new THREE.Scene();
			const fallbackCamera = new THREE.PerspectiveCamera(
				35,
				RENDER_WIDTH / RENDER_HEIGHT,
				0.1,
				100,
			);
			fallbackCamera.position.set(0, 1.4, 3.2);

			let camera: THREE.Camera = fallbackCamera;
			let mixer: THREE.AnimationMixer | null = null;
			let action: THREE.AnimationAction | null = null;
			let clipDuration = 0;
			let raf = 0;

			const renderFrame = () => {
				renderer.render(scene, camera);
			};

			const revealCanvas = () => {
				poster.hidden = true;
				canvas.hidden = false;
			};

			const timer = new THREE.Timer();
			const tick = (timestamp?: number) => {
				timer.update(timestamp);
				const delta = timer.getDelta();
				mixer?.update(delta);
				renderFrame();
				if (action && !action.paused) {
					raf = requestAnimationFrame(tick);
				}
			};

			Promise.all([
				new HDRLoader().loadAsync(ENVIRONMENT_URL),
				new GLTFLoader().loadAsync(MODEL_URL),
			])
				.then(([hdrTexture, gltf]) => {
					const environment = pmremGenerator.fromEquirectangular(hdrTexture).texture;
					scene.environment = environment;
					hdrTexture.dispose();
					pmremGenerator.dispose();

					scene.add(gltf.scene);

					const gltfCamera = gltf.cameras[0];
					if (gltfCamera) {
						camera = gltfCamera;
						if (camera instanceof THREE.PerspectiveCamera) {
							camera.aspect = RENDER_WIDTH / RENDER_HEIGHT;
							camera.zoom = CAMERA_ZOOM;
							camera.updateProjectionMatrix();
						}
					}

					const clip =
						gltf.animations.find((animationClip) => animationClip.name === CLIP_NAME) ??
						gltf.animations[0];
					if (clip) {
						clipDuration = clip.duration;
						mixer = new THREE.AnimationMixer(gltf.scene);
						action = mixer.clipAction(clip);
						action.setLoop(THREE.LoopOnce, 1);
						action.clampWhenFinished = true;
					}

					revealCanvas();

					if (reduceMotion || !mixer || !action) {
						if (mixer && action) {
							action.play();
							mixer.update(clipDuration);
						}
						renderFrame();
						showStaticComposition();
						return;
					}

					animation.classList.add('is-playing');
					action.play();
					timer.reset();
					tick();
				})
				.catch(() => {
					showStaticComposition();
				});

			window.addEventListener(
				'astro:before-swap',
				() => {
					cancelAnimationFrame(raf);
					renderer.dispose();
				},
				{ once: true },
			);
		});
	};

	initializeCardsAnimation();
	document.addEventListener('astro:page-load', initializeCardsAnimation);
</script>
