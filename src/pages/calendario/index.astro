---
import EmptyState from '../../components/EmptyState.astro';
import SeasonMap from '../../components/SeasonMap.astro';
import SeasonReveal from '../../components/SeasonReveal.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	isPublicPreseason,
	PUBLIC_SEASON_NAME,
	SEASON_STARTS_LABEL,
} from '../../lib/league-presentation';
import type { PublicMatchday } from '../../lib/public-league';
import { loadPublicLeagueView } from '../../lib/public-view';

const view = await loadPublicLeagueView();
const preseason = isPublicPreseason();
const statusLabels = { upcoming: 'Programada', current: 'En juego', completed: 'Finalizada' };
function encounterCountLabel(count: number): string {
	if (!count) return 'Enfrentamientos por confirmar';
	return `${count} ${count === 1 ? 'enfrentamiento' : 'enfrentamientos'}`;
}
const statusTones = { upcoming: 'info', current: 'warning', completed: 'success' };
const dateGroups = new Map<string, { date: Date; items: PublicMatchday[] }>();
for (const matchday of view.matchdays) {
	const date = new Date(matchday.date);
	const key = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Madrid' }).format(date);
	const group = dateGroups.get(key) ?? { date, items: [] };
	group.items.push(matchday);
	dateGroups.set(key, group);
}
const groups = [...dateGroups.entries()].sort(([left], [right]) => left.localeCompare(right));
const formatDay = new Intl.DateTimeFormat('es-ES', { day: '2-digit', timeZone: 'Europe/Madrid' });
const formatMonth = new Intl.DateTimeFormat('es-ES', { month: 'short', timeZone: 'Europe/Madrid' });
const formatWeekday = new Intl.DateTimeFormat('es-ES', {
	weekday: 'short',
	timeZone: 'Europe/Madrid',
});
---

<BaseLayout
	title={`Calendario y resultados Kings Padel League | ${PUBLIC_SEASON_NAME}`}
	description={`Consulta cuándo se juega cada jornada y sigue los resultados y el desglose por parejas de la ${PUBLIC_SEASON_NAME} de Kings Padel League.`}
>
	<main id="main-content" class="public-page public-page--calendar">
		<div class="o-container o-container--xl public-page__body">
			{
				preseason ? (
					<SeasonReveal
						eyebrow="Calendario próximamente"
						title={`La competición comienza el ${SEASON_STARTS_LABEL}.`}
						description="Publicaremos aquí las jornadas, los cruces, los horarios y los resultados cuando estén confirmados. Mientras tanto, conoce los equipos y jugadores de la temporada."
						items={['Mercado actualizado', 'Cruces confirmados', 'Calendario publicado']}
					>
						<a class="c-button c-button--primary" href="/equipos">
							Explorar la nueva parrilla
						</a>
						<a class="c-button c-button--outline" href="/">
							Volver al inicio
						</a>
					</SeasonReveal>
				) : (
					<>
						<header class="calendar-hero">
							<div class="calendar-hero__intro">
								<p class="c-eyebrow">{PUBLIC_SEASON_NAME} · Calendario oficial</p>
								<h1>Calendario y resultados de Kings Padel League</h1>
								<p>
									Consulta las fechas de las jornadas y accede a cada una para ver los
									enfrentamientos, horarios y resultados completos.
								</p>
							</div>
							<SeasonMap matchdays={view.matchdays} />
						</header>

						{view.matchdays.length ? (
							<>
								<section
									class="filters-panel filters-panel--calendar"
									aria-labelledby="calendar-filters-title"
									data-calendar-filters
								>
									<div class="filters-panel__heading">
										<div>
											<p class="c-eyebrow">Tu agenda</p>
											<h2 id="calendar-filters-title">Encuentra una jornada</h2>
										</div>
										<p role="status" aria-live="polite" data-calendar-count>
											{view.matchdays.length} {view.matchdays.length === 1 ? 'jornada' : 'jornadas'}
										</p>
									</div>
									<div class="filters-panel__grid filters-panel__grid--calendar">
										<label class="c-field">
											<span class="c-field__label">Estado</span>
											<select class="c-select" data-calendar-status>
												<option value="">Todos los estados</option>
												<option value="upcoming">Programadas</option>
												<option value="current">En juego</option>
												<option value="completed">Finalizadas</option>
											</select>
										</label>
										<label class="c-field">
											<span class="c-field__label">Equipo</span>
											<select class="c-select" data-calendar-team>
												<option value="">Todos los equipos</option>
												{view.teams.map((team) => (
													<option value={team.id}>{team.name}</option>
												))}
											</select>
										</label>
									</div>
									<div class="filters-panel__footer">
										<span>Filtra por estado o por equipo.</span>
										<button
											class="c-button c-button--ghost c-button--sm"
											type="button"
											data-calendar-clear
											hidden
										>
											Limpiar filtros
										</button>
									</div>
								</section>

								<div class="calendar-list" data-calendar-list>
									{groups.map(([key, group]) => {
										return (
											<section
												class="calendar-day"
												id={`day-${key}`}
												tabindex="-1"
												data-calendar-day
											>
												<div class="calendar-day__date">
													<span>{formatWeekday.format(group.date)}</span>
													<strong>{formatDay.format(group.date)}</strong>
													<span>{formatMonth.format(group.date)}</span>
												</div>
												<div class="match-list">
													<header class="calendar-day__heading">
														<p class="c-eyebrow">Jornadas del día</p>
														<h2>
															{new Intl.DateTimeFormat('es-ES', {
																dateStyle: 'long',
																timeZone: 'Europe/Madrid',
															}).format(group.date)}
														</h2>
													</header>
													{group.items.map((matchday) => (
														<article
															class="calendar-matchday"
															data-calendar-matchday
															data-status={matchday.status}
															data-teams={matchday.encounters
																.flatMap((encounter) => [
																	encounter.homeTeam.id,
																	encounter.awayTeam.id,
																])
																.join(' ')}
														>
															<div class="calendar-matchday__summary">
																<span
																	class:list={[
																		'c-chip',
																		`c-chip--tone-${statusTones[matchday.status]}`,
																	]}
																>
																	{statusLabels[matchday.status]}
																</span>
																<h3 transition:name={`kpl-matchday-${matchday.id}-title`}>
																	{matchday.label}
																</h3>
																<p>{encounterCountLabel(matchday.encounters.length)}</p>
																{matchday.encounters.length > 0 && (
																	<ul
																		class="calendar-matchday__encounters"
																		aria-label={`Enfrentamientos de ${matchday.label}`}
																	>
																		{matchday.encounters.map((encounter) => (
																			<li>
																				<span class="calendar-matchday__teams">
																					<span>{encounter.homeTeam.name}</span>
																					<span class="calendar-matchday__versus">vs</span>
																					<span>{encounter.awayTeam.name}</span>
																				</span>
																				<time datetime={encounter.scheduledAt}>
																					{encounter.scheduledAtLabel}
																				</time>
																			</li>
																		))}
																	</ul>
																)}
															</div>
															<a
																class="c-button c-button--primary"
																href={`/jornadas/${matchday.id}`}
																aria-label={`Ver jornada: ${matchday.label}`}
															>
																Ver jornada →
															</a>
														</article>
													))}
												</div>
											</section>
										);
									})}
								</div>
								<div class="directory-empty" role="status" data-calendar-empty hidden>
									<strong>No hay jornadas con esos filtros.</strong>
									<p>Prueba con otro estado o equipo.</p>
								</div>
							</>
						) : (
							<EmptyState
								title="Calendario pendiente"
								description="Aquí aparecerán las fechas, horarios y enfrentamientos oficiales de la liga."
							/>
						)}
					</>
				)
			}
		</div>
	</main>
</BaseLayout>

<script>
	document.addEventListener('astro:page-load', () => {
		const filters = document.querySelector<HTMLElement>('[data-calendar-filters]');
		if (filters) {
			const status = filters.querySelector<HTMLSelectElement>('[data-calendar-status]')!;
			const team = filters.querySelector<HTMLSelectElement>('[data-calendar-team]')!;
			const count = filters.querySelector<HTMLElement>('[data-calendar-count]')!;
			const clear = filters.querySelector<HTMLButtonElement>('[data-calendar-clear]')!;
			const empty = document.querySelector<HTMLElement>('[data-calendar-empty]')!;
			const matches = [...document.querySelectorAll<HTMLElement>('[data-calendar-matchday]')];
			const update = () => {
				let visible = 0;
				for (const match of matches) {
					const show =
						(!status.value || match.dataset.status === status.value) &&
						(!team.value || match.dataset.teams?.split(' ').includes(team.value));
					match.hidden = !show;
					if (show) visible += 1;
				}
				for (const day of document.querySelectorAll<HTMLElement>('[data-calendar-day]'))
					day.hidden = !day.querySelector('[data-calendar-matchday]:not([hidden])');
				count.textContent = `${visible} ${visible === 1 ? 'jornada' : 'jornadas'}`;
				empty.hidden = visible !== 0;
				clear.hidden = !(status.value || team.value);
			};
			filters.addEventListener('change', update);
			clear.addEventListener('click', () => {
				status.value = '';
				team.value = '';
				update();
				status.focus();
			});
		}
	});
</script>

<style>
	@layer app {
		.calendar-matchday__encounters {
			display: grid;
			gap: var(--kpl-space-3);
			inline-size: 100%;
			margin: 0;
			padding: var(--kpl-space-4) 0 0;
			border-block-start: var(--kpl-border-width) solid var(--kpl-color-border-subtle);
			list-style: none;
			font-size: var(--kpl-font-size-100);

			& li {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				justify-content: space-between;
				gap: var(--kpl-space-2) var(--kpl-space-5);
			}

			& time {
				color: var(--kpl-color-text-muted);
				font-size: var(--kpl-font-size-50);
			}
		}

		.calendar-matchday__teams {
			display: flex;
			flex-wrap: wrap;
			gap: var(--kpl-space-2);
			font-weight: 700;
		}

		.calendar-matchday__versus {
			color: var(--kpl-color-brand-strong);
			font-weight: 400;
		}
	}
</style>
