---
import EmptyState from '../../components/EmptyState.astro';
import MatchCard from '../../components/MatchCard.astro';
import PageHero from '../../components/PageHero.astro';
import SeasonReveal from '../../components/SeasonReveal.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	isPublicPreseason,
	PUBLIC_SEASON_NAME,
	SEASON_STARTS_LABEL,
} from '../../lib/league-presentation';
import type { PublicEncounter, PublicMatchday } from '../../lib/public-league';
import { loadPublicLeagueView } from '../../lib/public-view';

const view = await loadPublicLeagueView();
const preseason = isPublicPreseason();
const allEncounters = view.matchdays.flatMap((matchday) =>
	matchday.encounters.map((encounter) => ({ encounter, matchday })),
);
const finishedCount = allEncounters.filter(
	({ encounter }) => encounter.status === 'completed',
).length;
const upcomingCount = allEncounters.filter(
	({ encounter }) => encounter.status !== 'completed',
).length;
const dateGroups = new Map<
	string,
	{ date: Date; items: { encounter: PublicEncounter; matchday: PublicMatchday }[] }
>();
for (const item of allEncounters) {
	const date = new Date(item.encounter.scheduledAt);
	const key = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Madrid' }).format(date);
	const group = dateGroups.get(key) ?? { date, items: [] };
	group.items.push(item);
	dateGroups.set(key, group);
}
const groups = [...dateGroups.entries()].sort(([left], [right]) => left.localeCompare(right));
const formatDay = new Intl.DateTimeFormat('es-ES', { day: '2-digit', timeZone: 'Europe/Madrid' });
const formatMonth = new Intl.DateTimeFormat('es-ES', { month: 'short', timeZone: 'Europe/Madrid' });
const formatWeekday = new Intl.DateTimeFormat('es-ES', {
	weekday: 'short',
	timeZone: 'Europe/Madrid',
});
---

<BaseLayout
	title={`Calendario Kings Padel League | ${PUBLIC_SEASON_NAME}`}
	description={`Consulta las fechas, horarios y enfrentamientos de la ${PUBLIC_SEASON_NAME} de Kings Padel League. Filtra los partidos por estado o equipo.`}
>
	<main id="main-content" class="public-page public-page--calendar">
		<div class="o-container o-container--xl public-page__body">
			<PageHero
				eyebrow="Fechas y horarios de Kings Padel League"
				title={`Calendario de la ${PUBLIC_SEASON_NAME}`}
				description={preseason
					? 'El calendario aún no está publicado. Aquí encontrarás las fechas, los horarios y los enfrentamientos cuando se confirmen.'
					: 'Consulta todas las fechas, horarios y enfrentamientos. Filtra los partidos por estado o equipo.'}
				meta={preseason
					? ['Pretemporada', `Inicio · ${SEASON_STARTS_LABEL}`, 'Publicación próximamente']
					: [
							`${view.matchdays.length} jornadas`,
							`${allEncounters.length} partidos`,
							view.phaseLabel,
						]}
			>
				<a slot="actions" class="c-button c-button--primary" href="/equipos">Ver equipos</a>
				<a slot="actions" class="c-button c-button--outline" href="/jugadores">Ver jugadores</a>
			</PageHero>

			{
				preseason ? (
					<SeasonReveal
						eyebrow="Calendario próximamente"
						title={`La competición comienza el ${SEASON_STARTS_LABEL}.`}
						description="Publicaremos aquí las jornadas, los cruces y los horarios cuando estén confirmados. Mientras tanto, conoce los equipos y jugadores de la temporada."
						items={['Mercado actualizado', 'Cruces confirmados', 'Calendario publicado']}
					>
						<a class="c-button c-button--primary" href="/equipos">
							Explorar la nueva parrilla
						</a>
						<a class="c-button c-button--outline" href="/">
							Volver al inicio
						</a>
					</SeasonReveal>
				) : (
					<>
						<section class="calendar-overview" aria-label="Resumen del calendario">
							<article>
								<>
									<small>Jornadas</small>
									<strong>{view.matchdays.length}</strong>
								</>
							</article>
							<article>
								<>
									<small>Partidos</small>
									<strong>{allEncounters.length}</strong>
								</>
							</article>
							<article>
								<>
									<small>Finalizados</small>
									<strong>{finishedCount}</strong>
								</>
							</article>
							<article>
								<>
									<small>Pendientes</small>
									<strong>{upcomingCount}</strong>
								</>
							</article>
						</section>

						{allEncounters.length ? (
							<>
								<section
									class="filters-panel filters-panel--calendar"
									aria-labelledby="calendar-filters-title"
									data-calendar-filters
								>
									<div class="filters-panel__heading">
										<div>
											<p class="c-eyebrow">Tu agenda</p>
											<h2 id="calendar-filters-title">Encuentra un partido</h2>
										</div>
										<p role="status" aria-live="polite" data-calendar-count>
											{allEncounters.length} partidos
										</p>
									</div>
									<div class="filters-panel__grid filters-panel__grid--calendar">
										<label class="c-field">
											<span class="c-field__label">Estado</span>
											<select class="c-select" data-calendar-status>
												<option value="">Todos los estados</option>
												<option value="upcoming">Programados</option>
												<option value="current">En juego</option>
												<option value="completed">Finalizados</option>
											</select>
										</label>
										<label class="c-field">
											<span class="c-field__label">Equipo</span>
											<select class="c-select" data-calendar-team>
												<option value="">Todos los equipos</option>
												{view.teams.map((team) => (
													<option value={team.id}>{team.name}</option>
												))}
											</select>
										</label>
									</div>
									<div class="filters-panel__footer">
										<span>Filtra por estado o por equipo.</span>
										<button
											class="c-button c-button--ghost c-button--sm"
											type="button"
											data-calendar-clear
											hidden
										>
											Limpiar filtros
										</button>
									</div>
								</section>

								<div class="calendar-list" data-calendar-list>
									{groups.map(([, group]) => (
										<section class="calendar-day" data-calendar-day>
											<div class="calendar-day__date">
												<span>{formatWeekday.format(group.date)}</span>
												<strong>{formatDay.format(group.date)}</strong>
												<span>{formatMonth.format(group.date)}</span>
											</div>
											<div class="match-list">
												<header class="calendar-day__heading">
													<p class="c-eyebrow">Agenda del día</p>
													<h2>
														{new Intl.DateTimeFormat('es-ES', {
															dateStyle: 'long',
															timeZone: 'Europe/Madrid',
														}).format(group.date)}
													</h2>
												</header>
												{group.items.map(({ encounter, matchday }) => (
													<div
														data-calendar-match
														data-status={encounter.status}
														data-home={encounter.homeTeam.id}
														data-away={encounter.awayTeam.id}
													>
														<MatchCard
															encounter={encounter}
															matchdayHref={`/jornadas/${matchday.id}`}
														/>
													</div>
												))}
											</div>
										</section>
									))}
								</div>
								<div class="directory-empty" role="status" data-calendar-empty hidden>
									<strong>No hay partidos con esos filtros.</strong>
									<p>Prueba con otro estado o equipo.</p>
								</div>
							</>
						) : (
							<EmptyState
								title="Calendario pendiente"
								description="Aquí aparecerán las fechas, horarios y enfrentamientos oficiales de la liga."
							/>
						)}
					</>
				)
			}
		</div>
	</main>
</BaseLayout>

<script>
	document.addEventListener('astro:page-load', () => {
		const filters = document.querySelector<HTMLElement>('[data-calendar-filters]');
		if (filters) {
			const status = filters.querySelector<HTMLSelectElement>('[data-calendar-status]')!;
			const team = filters.querySelector<HTMLSelectElement>('[data-calendar-team]')!;
			const count = filters.querySelector<HTMLElement>('[data-calendar-count]')!;
			const clear = filters.querySelector<HTMLButtonElement>('[data-calendar-clear]')!;
			const empty = document.querySelector<HTMLElement>('[data-calendar-empty]')!;
			const matches = [...document.querySelectorAll<HTMLElement>('[data-calendar-match]')];
			const update = () => {
				let visible = 0;
				for (const match of matches) {
					const show =
						(!status.value || match.dataset.status === status.value) &&
						(!team.value || match.dataset.home === team.value || match.dataset.away === team.value);
					match.hidden = !show;
					if (show) visible += 1;
				}
				for (const day of document.querySelectorAll<HTMLElement>('[data-calendar-day]'))
					day.hidden = !day.querySelector('[data-calendar-match]:not([hidden])');
				count.textContent = `${visible} ${visible === 1 ? 'partido' : 'partidos'}`;
				empty.hidden = visible !== 0;
				clear.hidden = !(status.value || team.value);
			};
			filters.addEventListener('change', update);
			clear.addEventListener('click', () => {
				status.value = '';
				team.value = '';
				update();
				status.focus();
			});
		}
	});
</script>
