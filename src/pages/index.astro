---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import { selectPublishedAnnouncements } from '../lib/announcements';
import { loadLeagueHomeData } from '../lib/kpl-api';
import { resolveHomeSeasonStatus } from '../lib/league-status';
import '../styles/home.css';

const buildDate = new Date();
const [{ seasons, matchdays, playoffs, playoffMatches }, announcementEntries] = await Promise.all([
	loadLeagueHomeData(),
	getCollection('announcements'),
]);
const seasonStatus = resolveHomeSeasonStatus(
	seasons,
	matchdays,
	buildDate,
	playoffs,
	playoffMatches,
);
const announcements = selectPublishedAnnouncements(announcementEntries, buildDate);
const announcementCategoryLabels = {
	calendario: 'Calendario',
	equipos: 'Equipos',
	cartas: 'Competición',
} as const;
const announcementDateFormatter = new Intl.DateTimeFormat('es-ES', {
	day: 'numeric',
	month: 'short',
	year: 'numeric',
	timeZone: 'Europe/Madrid',
});
---

<BaseLayout
	title="Kings Padel League | Liga amateur de pádel"
	description="Sigue la temporada, las novedades y todos los canales oficiales de Kings Padel League."
>
	<main class="home-page" id="main-content" tabindex="-1">
		<section class="home-hero" aria-labelledby="home-title">
			<div class="home-hero__layout o-container">
				<div class="home-hero__content o-stack">
					<img
						class="home-hero__logo"
						src="/kpl-logo-wordmark.png"
						alt="Kings Padel League"
						width="318"
						height="135"
						loading="eager"
						decoding="async"
					/>

					<div class="home-hero__heading o-stack o-stack--compact">
						<div class="o-cluster">
							<span class="c-chip c-chip--tone-brand">{seasonStatus.seasonName}</span>
							<span class="c-chip c-chip--tone-success">{seasonStatus.phaseLabel}</span>
						</div>
						<h1 id="home-title">La liga se vive dentro y fuera de la pista.</h1>
						<p class="home-hero__lead">
							Sigue cada jornada, conoce a los jugadores y descubre todo lo que viene en Kings Padel
							League.
						</p>
					</div>

					<dl class="home-hero__status" aria-label="Estado actual de la temporada">
						<div class="home-hero__status-item">
							<dt>{seasonStatus.matchdayEyebrow}</dt>
							<dd>{seasonStatus.matchdayLabel}</dd>
						</div>
						<div class="home-hero__status-item">
							<dt>Fecha</dt>
							<dd>{seasonStatus.dateLabel}</dd>
						</div>
					</dl>

					<div class="home-hero__actions">
						<a
							class="c-button c-button--primary c-button--lg"
							href={seasonStatus.phaseLabel === 'Playoffs'
								? seasonStatus.focusHref
								: '/clasificacion'}
						>
							{seasonStatus.phaseLabel === 'Playoffs' ? 'Ver playoffs' : 'Ver clasificación'}
							<svg aria-hidden="true" viewBox="0 0 20 20">
								<path
									d="m7 4 6 6-6 6"
									fill="none"
									stroke="currentColor"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"></path>
							</svg>
						</a>
						<a class="c-button c-button--outline c-button--lg" href="/jugadores">
							Conocer jugadores
						</a>
					</div>
				</div>

				<div class="home-hero__art" aria-hidden="true">
					<div class="home-hero__orb">
						<img
							class="home-hero__trophy"
							src="/kpl-trophy.png"
							alt=""
							width="500"
							height="500"
							decoding="async"
						/>
					</div>
					<p class="home-hero__art-caption">
						<strong>KPL</strong><span>Una pista. Una corona.</span>
					</p>
				</div>
			</div>
		</section>

		{
			announcements.length > 0 && (
				<section
					class="home-section o-container o-region o-stack"
					aria-labelledby="announcements-title"
				>
					<header class="c-section-heading">
						<div class="c-section-heading__copy">
							<p class="c-section-heading__eyebrow">Última hora</p>
							<h2 id="announcements-title">Lo nuevo en la liga</h2>
						</div>
						<p class="home-section__intro">
							Calendario, equipos y novedades que cambiarán la próxima temporada.
						</p>
					</header>

					<div class="home-announcements o-grid o-grid--cards">
						{announcements.map(({ data }, index) => (
							<article
								class:list={[
									'home-announcement',
									'c-surface-card',
									'c-surface-card--padded',
									{ 'home-announcement--featured': index === 0 },
								]}
							>
								<div class="home-announcement__meta">
									<span class="c-chip c-chip--tone-brand">
										{announcementCategoryLabels[data.category]}
									</span>
									<time datetime={data.publishedAt.toISOString()}>
										{announcementDateFormatter.format(data.publishedAt)}
									</time>
								</div>
								<div class="home-announcement__copy">
									<h3>{data.title}</h3>
									<p>{data.summary}</p>
								</div>
								<span class="home-announcement__number" aria-hidden="true">
									0{index + 1}
								</span>
							</article>
						))}
					</div>
				</section>
			)
		}

		<section class="home-social o-container o-region" aria-labelledby="social-title">
			<div class="home-social__panel c-panel c-panel--accent">
				<div class="home-social__copy">
					<p class="c-eyebrow">Dentro de la liga</p>
					<h2 id="social-title">No te pierdas ningún punto.</h2>
					<p>Highlights, anuncios, mejores jugadas y todo lo que sucede detrás de cada jornada.</p>
				</div>

				<div class="home-social__links">
					<a
						class="home-social__link"
						href="https://www.instagram.com/kingspadel.league/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Seguir Kings Padel League en Instagram (se abre en una pestaña nueva)"
					>
						<svg aria-hidden="true" viewBox="0 0 24 24">
							<rect
								x="3"
								y="3"
								width="18"
								height="18"
								rx="5"
								fill="none"
								stroke="currentColor"
								stroke-width="2"></rect>
							<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"
							></circle>
							<circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle>
						</svg>
						<span><small>Síguenos en</small><strong>Instagram</strong></span>
						<span aria-hidden="true">↗</span>
					</a>

					<a
						class="home-social__link"
						href="https://www.youtube.com/@KPLeague"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Ver Kings Padel League en YouTube (se abre en una pestaña nueva)"
					>
						<svg aria-hidden="true" viewBox="0 0 24 24">
							<path
								d="M21 8.2a3 3 0 0 0-2.1-2.1C17 5.6 12 5.6 12 5.6s-5 0-6.9.5A3 3 0 0 0 3 8.2 31 31 0 0 0 2.6 12c0 1.3.1 2.6.4 3.8a3 3 0 0 0 2.1 2.1c1.9.5 6.9.5 6.9.5s5 0 6.9-.5a3 3 0 0 0 2.1-2.1c.3-1.2.4-2.5.4-3.8s-.1-2.6-.4-3.8Z"
								fill="none"
								stroke="currentColor"
								stroke-width="2"></path>
							<path d="m10 9 5 3-5 3V9Z" fill="currentColor"></path>
						</svg>
						<span><small>Vídeos en</small><strong>YouTube</strong></span>
						<span aria-hidden="true">↗</span>
					</a>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
