---
import EmptyState from '../../components/EmptyState.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	isPublicPreseason,
	PUBLIC_SEASON_NAME,
	SEASON_STARTS_LABEL,
} from '../../lib/league-presentation';
import { loadPublicLeagueView } from '../../lib/public-view';
import { teamThemeStyle } from '../../lib/team-identity';

const view = await loadPublicLeagueView();
const preseason = isPublicPreseason();
const playerCount = view.teams.reduce((total, team) => total + team.players.length, 0);
---

<BaseLayout
	title={`Equipos de Kings Padel League | ${PUBLIC_SEASON_NAME}`}
	description={`Conoce los equipos de la ${PUBLIC_SEASON_NAME} de Kings Padel League: presidencias, jugadores, posiciones y plantillas.`}
>
	<main id="main-content" class="public-page public-page--teams">
		<div class="o-container o-container--xl public-page__body">
			<PageHero
				eyebrow="Equipos de Kings Padel League"
				title={`Equipos y plantillas de la ${PUBLIC_SEASON_NAME}`}
				description="Conoce los equipos, sus presidencias y los jugadores que competirán en la liga amateur de pádel."
				meta={[
					`${view.teams.length} equipos confirmados`,
					`${playerCount} jugadores`,
					preseason ? 'Mercado abierto' : 'Plantillas de la temporada',
				]}
			>
				<a slot="actions" class="c-button c-button--primary" href="/jugadores">
					Ver todos los jugadores
				</a>
				<a slot="actions" class="c-button c-button--outline" href="/calendario">
					Consultar calendario
				</a>
			</PageHero>

			{
				preseason && (
					<aside class="market-status" aria-label="Estado del mercado de equipos">
						<span class="market-status__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24">
								<path d="M4 7h16M7 4v6m10-6v6M5 12h14v8H5zM9 16h6" />
							</svg>
						</span>
						<div>
							<p class="c-eyebrow">Mercado de la {PUBLIC_SEASON_NAME}</p>
							<h2>Consulta los fichajes confirmados de la temporada.</h2>
							<p>
								La competición comienza el {SEASON_STARTS_LABEL}. Aquí encontrarás las altas,
								cambios de equipo y plantillas confirmadas.
							</p>
						</div>
						<span class="c-chip c-chip--tone-info">Fichajes confirmados</span>
					</aside>
				)
			}

			<section class="section-block team-catalog" aria-labelledby="team-catalog-title">
				<header class="section-block__header section-block__header--editorial">
					<div>
						<p class="c-eyebrow">Clubes participantes</p>
						<h2 id="team-catalog-title">Todos los equipos de Kings Padel League.</h2>
					</div>
					<p>Abre cada equipo para conocer su identidad, presidencia y plantilla.</p>
				</header>

				{
					view.teams.length ? (
						<ol class="team-grid team-grid--premium" aria-label="Equipos de la liga">
							{view.teams.map((team, index) => (
								<li>
									<a
										class="team-card team-card--premium"
										href={`/equipos/${team.slug}`}
										style={teamThemeStyle(team)}
									>
										<span class="team-card__identity-accent" aria-hidden="true" />
										<span class="team-card__number" aria-hidden="true">
											0{index + 1}
										</span>
										<span class="team-card__halo" aria-hidden="true" />
										<span
											class="team-card__logo"
											aria-hidden="true"
											transition:name={`kpl-team-${team.slug}-crest`}
										>
											{team.logoPath ? (
												<img
													src={team.logoPath}
													alt=""
													width="240"
													height="240"
													loading={index > 1 ? 'lazy' : 'eager'}
													decoding="async"
												/>
											) : (
												team.monogram
											)}
										</span>
										<span class="team-card__copy">
											<span class="team-card__meta">
												<small>{team.players.length} jugadores</small>
												<small>{preseason ? 'Nueva temporada' : 'Equipo oficial'}</small>
											</span>
											<strong
												class="team-card__name"
												transition:name={`kpl-team-${team.slug}-name`}
											>
												{team.name}
											</strong>
											<span class="team-card__tagline">{team.tagline}</span>
											<span class="team-card__president">Presidencia · {team.presidentLabel}</span>
											<span class="team-card__cta">
												Explorar equipo <span aria-hidden="true">↗</span>
											</span>
										</span>
									</a>
								</li>
							))}
						</ol>
					) : (
						<EmptyState
							title="Los equipos se anunciarán próximamente"
							description={`Aquí podrás conocer los clubes y plantillas confirmados para la ${PUBLIC_SEASON_NAME}.`}
						/>
					)
				}
			</section>
		</div>
	</main>
</BaseLayout>
