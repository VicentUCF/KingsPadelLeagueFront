---
import EmptyState from '../../components/EmptyState.astro';
import PlayerCard from '../../components/PlayerCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublicPreseason, PUBLIC_SEASON_NAME } from '../../lib/league-presentation';
import type { PublicTeam } from '../../lib/public-league';
import { loadPublicLeagueView } from '../../lib/public-view';
import { teamThemeStyle } from '../../lib/team-identity';

export async function getStaticPaths() {
	const view = await loadPublicLeagueView();
	return view.teams.map((team) => ({ params: { slug: team.slug }, props: { team } }));
}

interface Props {
	team: PublicTeam;
}

const { team } = Astro.props;
const preseason = isPublicPreseason();
const teamStyle = teamThemeStyle(team);
const presidents = team.players.filter((player) => player.isPresident);
const teamUrl = Astro.site ? new URL(`/equipos/${team.slug}`, Astro.site).href : null;
const teamStructuredData = teamUrl
	? [
			{
				'@context': 'https://schema.org',
				'@type': 'SportsTeam',
				name: team.name,
				description: team.description,
				sport: 'Pádel',
				url: teamUrl,
				...(team.logoPath ? { logo: new URL(team.logoPath, Astro.site!).href } : {}),
				member: team.players.map((player) => ({
					'@type': 'Person',
					name: player.displayName,
					url: new URL(`/jugadores/${player.slug}`, Astro.site!).href,
				})),
			},
			{
				'@context': 'https://schema.org',
				'@type': 'BreadcrumbList',
				itemListElement: [
					{
						'@type': 'ListItem',
						position: 1,
						name: 'Equipos',
						item: new URL('/equipos', Astro.site!).href,
					},
					{ '@type': 'ListItem', position: 2, name: team.name, item: teamUrl },
				],
			},
		]
	: undefined;
---

<BaseLayout
	title={`${team.name}: plantilla y jugadores | Kings Padel League`}
	description={`Consulta la plantilla de ${team.name} para la ${PUBLIC_SEASON_NAME}: presidencia, jugadores, posiciones y perfiles.`}
	image={team.logoPath ?? undefined}
	imageAlt={team.logoPath ? `Escudo de ${team.name}` : undefined}
	structuredData={teamStructuredData}
>
	<main id="main-content" class="public-page public-page--team-detail" style={teamStyle}>
		<div class="o-container o-container--xl public-page__body">
			<nav class="c-breadcrumbs" aria-label="Migas de pan">
				<a class="c-breadcrumbs__item" href="/equipos">← Todos los equipos</a>
			</nav>

			<article class="team-profile-hero">
				<span class="team-profile-hero__identity-accent" aria-hidden="true"></span>
				<span class="team-profile-hero__light-sweep" aria-hidden="true"></span>
				<span class="team-profile-hero__motion-ribbon" aria-hidden="true">
					<span class="team-profile-hero__motion-ribbon-track">
						{
							Array.from({ length: 2 }, () => (
								<span class="team-profile-hero__motion-ribbon-group">
									<span>{team.name}</span>
									<span>Kings Padel League</span>
									<span>{PUBLIC_SEASON_NAME}</span>
									<span>{team.name}</span>
									<span>Kings Padel League</span>
									<span>{PUBLIC_SEASON_NAME}</span>
								</span>
							))
						}
					</span>
				</span>
				<span class="team-profile-hero__number" aria-hidden="true">KPL</span>
				<div class="team-profile-hero__identity">
					<div class="team-profile-hero__status">
						<span class="c-chip c-chip--tone-brand">{PUBLIC_SEASON_NAME}</span>
						<span class="c-chip"
							>{preseason ? 'Plantilla de pretemporada' : 'Equipo en competición'}</span
						>
					</div>
					<div class="team-profile-hero__copy">
						<p class="c-eyebrow">Identidad del club</p>
						<h1 transition:name={`kpl-team-${team.slug}-name`}>{team.name}</h1>
						<p class="team-profile-hero__tagline">{team.tagline}</p>
						<p class="team-profile-hero__description">{team.description}</p>
					</div>
					{
						team.signature && (
							<aside class="team-profile-hero__signature" aria-label="Firma del equipo">
								{team.signature.secondaryMarkPath && (
									<img src={team.signature.secondaryMarkPath} alt="" width="56" height="38" />
								)}
								<span>
									<small>Team issue</small>
									<strong>{team.signature.edition}</strong>
								</span>
								<p>{team.signature.motto}</p>
							</aside>
						)
					}
					<dl class="team-profile-hero__facts">
						<div>
							<dt>Jugadores</dt>
							<dd>{team.players.length} jugadores</dd>
						</div>
						<div>
							<dt>Presidencia</dt>
							<dd>{team.presidentLabel}</dd>
						</div>
						<div>
							<dt>Estado</dt>
							<dd>{preseason ? 'Mercado abierto' : 'Compitiendo'}</dd>
						</div>
					</dl>
				</div>

				<div class="team-profile-hero__visual" aria-hidden="true">
					<span class="team-profile-hero__logo" transition:name={`kpl-team-${team.slug}-crest`}>
						{
							team.logoPath ? (
								<img src={team.logoPath} alt="" width="440" height="440" decoding="async" />
							) : (
								team.monogram
							)
						}
					</span>
				</div>
			</article>

			{
				preseason && (
					<aside class="team-update-note">
						<div>
							<p class="c-eyebrow">Plantilla de la {PUBLIC_SEASON_NAME}</p>
							<h2>Fichajes y roles confirmados de {team.name}.</h2>
						</div>
						<p>
							Consulta aquí las incorporaciones, los cambios de equipo y los roles confirmados antes
							del inicio de la competición.
						</p>
					</aside>
				)
			}

			<section class="section-block team-roster" aria-labelledby="roster-title">
				<header class="section-block__header section-block__header--editorial">
					<div>
						<p class="c-eyebrow">{preseason ? 'Plantilla confirmada' : 'Plantilla oficial'}</p>
						<h2 id="roster-title">Las caras de {team.name}</h2>
					</div>
					<div class="section-block__actions">
						{
							presidents.length > 0 && (
								<span class="c-chip c-chip--tone-brand">
									{presidents.length === 1
										? team.presidentLabel
										: `${presidents.length} presidentes`}
								</span>
							)
						}
						<a class="c-button c-button--outline" href="/calendario">Ver calendario</a>
						<a class="c-button c-button--outline" href="/clasificacion">Ver clasificación</a>
					</div>
				</header>

				{
					team.players.length ? (
						<ol class="player-list player-list--cards">
							{team.players.map((player) => (
								<li>
									<PlayerCard player={player} team={team} preseason={preseason} compact />
								</li>
							))}
						</ol>
					) : (
						<EmptyState
							title="La plantilla se anunciará pronto"
							description={`Todavía no hay jugadores confirmados para ${team.name}. Vuelve pronto para conocer su plantilla de la ${PUBLIC_SEASON_NAME}.`}
						/>
					)
				}
			</section>
		</div>
	</main>
</BaseLayout>
