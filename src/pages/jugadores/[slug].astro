---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublicPreseason, PUBLIC_SEASON_NAME } from '../../lib/league-presentation';
import type { PublicPlayer, PublicTeam } from '../../lib/public-league';
import { loadPublicLeagueView } from '../../lib/public-view';

export async function getStaticPaths() {
	const view = await loadPublicLeagueView();
	const teamById = new Map(view.teams.map((team) => [team.id, team]));
	return view.players.map((player) => ({
		params: { slug: player.slug },
		props: {
			player,
			team: player.teamId ? teamById.get(player.teamId) : undefined,
		},
	}));
}

interface Props {
	player: PublicPlayer;
	team?: PublicTeam;
}

const { player, team } = Astro.props;
const preseason = isPublicPreseason();
const palette = team?.palette ?? {
	primary: '#e0bb45',
	accent: '#f5e3a3',
	surface: '#1d1710',
	glow: 'rgb(224 187 69 / 0.42)',
};
const profileStyle = `--team-primary:${palette.primary};--team-accent:${palette.accent};--team-surface:${palette.surface};--team-glow:${palette.glow}`;
const played = player.wonGames + player.lostGames;
const winRate = played ? `${Math.round((player.wonGames / played) * 100)}%` : '—';
const playerUrl = Astro.site ? new URL(`/jugadores/${player.slug}`, Astro.site).href : null;
const playerStructuredData = playerUrl
	? [
			{
				'@context': 'https://schema.org',
				'@type': 'Person',
				name: player.displayName,
				url: playerUrl,
				...(player.profileImage ? { image: new URL(player.profileImage, Astro.site!).href } : {}),
				memberOf: {
					'@type': 'SportsTeam',
					name: player.teamName,
					...(team ? { url: new URL(`/equipos/${team.slug}`, Astro.site!).href } : {}),
				},
			},
			{
				'@context': 'https://schema.org',
				'@type': 'BreadcrumbList',
				itemListElement: [
					{
						'@type': 'ListItem',
						position: 1,
						name: 'Jugadores',
						item: new URL('/jugadores', Astro.site!).href,
					},
					{ '@type': 'ListItem', position: 2, name: player.displayName, item: playerUrl },
				],
			},
		]
	: undefined;
---

<BaseLayout
	title={`${player.displayName}: equipo, posición y estadísticas | KPL`}
	description={`Consulta el perfil de ${player.displayName}: equipo, posición, rol y estadísticas en la ${PUBLIC_SEASON_NAME} de Kings Padel League.`}
	image={player.profileImage ?? undefined}
	imageAlt={player.profileImage ? `Retrato de ${player.displayName}` : undefined}
	pageType="profile"
	structuredData={playerStructuredData}
>
	<main id="main-content" class="public-page public-page--player-detail" style={profileStyle}>
		<div class="o-container o-container--xl public-page__body">
			<nav class="c-breadcrumbs" aria-label="Migas de pan">
				<a class="c-breadcrumbs__item" href="/jugadores">← Todos los jugadores</a>
				{
					team && (
						<a class="c-breadcrumbs__item" href={`/equipos/${team.slug}`}>
							{team.name}
						</a>
					)
				}
			</nav>

			<article class="player-profile player-profile--premium">
				<div class="player-profile__visual">
					<span class="player-profile__watermark" aria-hidden="true">
						{player.firstName}
					</span>
					<span class="player-profile__orbit" aria-hidden="true"></span>
					{
						player.profileImage ? (
							<img
								src={player.profileImage}
								alt={`Retrato de ${player.displayName}`}
								width="680"
								height="840"
								decoding="async"
							/>
						) : (
							<span class="player-profile__initials" aria-hidden="true">
								{player.firstName[0]}
								{player.lastName[0]}
							</span>
						)
					}
					<div class="player-profile__visual-meta">
						<span>{player.positionLabel}</span>
						<span>{player.isPresident ? 'Presidencia' : 'Jugador KPL'}</span>
					</div>
				</div>

				<div class="player-profile__detail">
					<div class="player-profile__status">
						<span class="c-chip c-chip--tone-brand">{PUBLIC_SEASON_NAME}</span>
						<span class="c-chip">{preseason ? 'Pretemporada' : `Ranking #${player.rank}`}</span>
					</div>

					<header class="player-profile__header">
						<p class="c-eyebrow">Perfil del jugador</p>
						<h1>{player.displayName}</h1>
						<p>
							<span>{player.teamName}</span>
							<span aria-hidden="true">·</span>
							<span>{player.positionLabel}</span>
							{
								player.isPresident && (
									<>
										<>
											<span aria-hidden="true">·</span>
											<span>Presidente</span>
										</>
									</>
								)
							}
						</p>
					</header>

					{
						preseason ? (
							<div class="player-profile__season-card">
								<div>
									<p class="c-eyebrow">Perfil de la {PUBLIC_SEASON_NAME}</p>
									<h2>
										{player.displayName} jugará con {player.teamName}.
									</h2>
								</div>
								<p>
									Posición: {player.positionLabel}. Consulta de nuevo este perfil para conocer sus
									estadísticas cuando empiece la competición.
								</p>
							</div>
						) : (
							<div class="player-profile__metrics" aria-label="Estadísticas del jugador">
								<article>
									<>
										<small>Puntos</small>
										<strong>{player.totalPoints}</strong>
									</>
								</article>
								<article>
									<>
										<small>Victorias</small>
										<strong>{player.wonGames}</strong>
									</>
								</article>
								<article>
									<>
										<small>Partidos</small>
										<strong>{played}</strong>
									</>
								</article>
								<article>
									<>
										<small>Efectividad</small>
										<strong>{winRate}</strong>
									</>
								</article>
							</div>
						)
					}

					<dl class="player-profile__facts">
						<div><dt>Equipo</dt><dd>{player.teamName}</dd></div>
						<div><dt>Lado preferente</dt><dd>{player.positionLabel}</dd></div>
						<div>
							<dt>Rol</dt><dd>{player.isPresident ? 'Presidente y jugador' : 'Jugador'}</dd>
						</div>
						<div><dt>Temporada</dt><dd>{PUBLIC_SEASON_NAME}</dd></div>
					</dl>

					<div class="player-profile__actions">
						{
							team ? (
								<a class="c-button c-button--primary c-button--lg" href={`/equipos/${team.slug}`}>
									Ver {team.name}
								</a>
							) : (
								<span class="c-chip">Equipo por confirmar</span>
							)
						}
						<a class="c-button c-button--outline c-button--lg" href="/jugadores">
							Ver todos los jugadores
						</a>
					</div>
				</div>
			</article>
		</div>
	</main>
</BaseLayout>
