---
import EmptyState from '../../components/EmptyState.astro';
import PageHero from '../../components/PageHero.astro';
import PlayerCard from '../../components/PlayerCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	isPublicPreseason,
	PUBLIC_SEASON_NAME,
	SEASON_STARTS_LABEL,
} from '../../lib/league-presentation';
import { loadPublicLeagueView } from '../../lib/public-view';

const view = await loadPublicLeagueView();
const preseason = isPublicPreseason();
const teamById = new Map(view.teams.map((team) => [team.id, team]));
const presidents = view.players.filter((player) => player.isPresident).length;
---

<BaseLayout
	title={`Jugadores de Kings Padel League | ${PUBLIC_SEASON_NAME}`}
	description="Busca jugadores de Kings Padel League por nombre, equipo o posición y consulta su perfil y estadísticas de la temporada."
>
	<main id="main-content" class="public-page public-page--players">
		<div class="o-container o-container--xl public-page__body">
			<PageHero
				eyebrow="Jugadores de Kings Padel League"
				title={`Jugadores de la ${PUBLIC_SEASON_NAME}`}
				description="Busca por nombre, equipo o posición —drive o revés— y abre cada perfil para conocer su rol y sus estadísticas."
				meta={[
					`${view.players.length} jugadores`,
					`${view.teams.length} equipos`,
					preseason ? 'Plantillas de pretemporada' : 'Temporada en curso',
				]}
				mark="T2"
			>
				<a slot="actions" class="c-button c-button--primary" href="/equipos">Explorar equipos</a>
			</PageHero>

			<section class="player-overview" aria-label="Resumen de jugadores">
				<article>
					<span>01</span><small>Jugadores</small><strong>{view.players.length}</strong>
				</article>
				<article>
					<span>02</span><small>Equipos</small><strong>{view.teams.length}</strong>
				</article>
				<article>
					<span>03</span><small>Presidencias</small><strong>{presidents}</strong>
				</article>
				<article>
					<span>04</span><small>Inicio de liga</small><strong class="player-overview__date"
						>{SEASON_STARTS_LABEL}</strong
					>
				</article>
			</section>

			{
				preseason && (
					<aside class="roster-status">
						<div>
							<span class="roster-status__pulse" aria-hidden="true" />
							<p class="c-eyebrow">Mercado de jugadores</p>
							<h2>Consulta los jugadores confirmados de la {PUBLIC_SEASON_NAME}.</h2>
						</div>
						<p>
							Los cambios de equipo y nuevas incorporaciones aparecerán aquí antes del inicio, el
							{SEASON_STARTS_LABEL}.
						</p>
					</aside>
				)
			}

			{
				view.players.length ? (
					<>
						<section
							class="filters-panel filters-panel--players"
							aria-labelledby="player-filters-title"
							data-player-filters
						>
							<div class="filters-panel__heading">
								<div>
									<p class="c-eyebrow">Encuentra un jugador</p>
									<h2 id="player-filters-title">Busca por equipo y posición</h2>
								</div>
								<p role="status" aria-live="polite" data-player-count>
									{view.players.length} jugadores
								</p>
							</div>
							<div class="filters-panel__grid">
								<label class="c-field filters-panel__search">
									<span class="c-field__label">Nombre o alias</span>
									<input
										class="c-input c-input--search"
										type="search"
										placeholder="Buscar jugador"
										autocomplete="off"
										data-player-search
									/>
								</label>
								<label class="c-field">
									<span class="c-field__label">Equipo</span>
									<select class="c-select" data-player-team>
										<option value="">Todos los equipos</option>
										{view.teams.map((team) => (
											<option value={team.id}>{team.name}</option>
										))}
									</select>
								</label>
								<label class="c-field">
									<span class="c-field__label">Posición</span>
									<select class="c-select" data-player-side>
										<option value="">Todos los lados</option>
										<option value="left">Revés</option>
										<option value="right">Drive</option>
										<option value="both">Ambos lados</option>
									</select>
								</label>
							</div>
							<div class="filters-panel__footer">
								<span>Busca por nombre, equipo o lado de juego.</span>
								<button
									class="c-button c-button--ghost c-button--sm"
									type="button"
									data-player-clear
									hidden
								>
									Limpiar filtros
								</button>
							</div>
						</section>

						<section class="section-block" aria-labelledby="players-results-title">
							<header class="section-block__header section-block__header--editorial">
								<div>
									<p class="c-eyebrow">Plantillas de la liga</p>
									<h2 id="players-results-title">Todos los jugadores de la {PUBLIC_SEASON_NAME}</h2>
								</div>
								<p>Abre un perfil para consultar posición, equipo, rol y estadísticas.</p>
							</header>
							<ol class="player-list player-list--cards" data-player-list>
								{view.players.map((player) => (
									<li>
										<PlayerCard
											player={player}
											team={player.teamId ? teamById.get(player.teamId) : undefined}
											preseason={preseason}
										/>
									</li>
								))}
							</ol>
							<div class="directory-empty" role="status" data-player-empty hidden>
								<strong>No encontramos coincidencias.</strong>
								<p>Prueba con otro nombre, equipo o lado de juego.</p>
							</div>
						</section>
					</>
				) : (
					<EmptyState
						title="Las nuevas plantillas se anunciarán pronto"
						description={`Los perfiles aparecerán aquí conforme se confirme el mercado de la ${PUBLIC_SEASON_NAME}.`}
					/>
				)
			}
		</div>
	</main>
</BaseLayout>

<script>
	const root = document.querySelector<HTMLElement>('[data-player-filters]');
	if (root) {
		const search = root.querySelector<HTMLInputElement>('[data-player-search]')!;
		const team = root.querySelector<HTMLSelectElement>('[data-player-team]')!;
		const side = root.querySelector<HTMLSelectElement>('[data-player-side]')!;
		const count = root.querySelector<HTMLElement>('[data-player-count]')!;
		const clear = root.querySelector<HTMLButtonElement>('[data-player-clear]')!;
		const empty = document.querySelector<HTMLElement>('[data-player-empty]')!;
		const cards = [...document.querySelectorAll<HTMLElement>('[data-player-card]')];
		const update = () => {
			const query = search.value.trim().toLocaleLowerCase('es');
			let visible = 0;
			for (const card of cards) {
				const matchesSearch = !query || card.dataset.name?.includes(query);
				const matchesTeam = !team.value || card.dataset.team === team.value;
				const matchesSide = !side.value || card.dataset.side === side.value;
				const show = Boolean(matchesSearch && matchesTeam && matchesSide);
				card.closest('li')!.hidden = !show;
				if (show) visible += 1;
			}
			count.textContent = `${visible} ${visible === 1 ? 'jugador' : 'jugadores'}`;
			empty.hidden = visible !== 0;
			clear.hidden = !(query || team.value || side.value);
		};
		root.addEventListener('input', update);
		root.addEventListener('change', update);
		clear.addEventListener('click', () => {
			search.value = '';
			team.value = '';
			side.value = '';
			update();
			search.focus();
		});
	}
</script>
