---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import NewsArticleContent from '../../components/NewsArticleContent.astro';
import NewsCard from '../../components/NewsCard.astro';
import TeamBadge from '../../components/TeamBadge.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NEWS_CATEGORY_DESTINATIONS, selectPublishedNews } from '../../lib/news';
import { loadPublicLeagueView } from '../../lib/public-view';
import '../../styles/news.css';

export async function getStaticPaths() {
	const entries = await getCollection('news');
	const published = selectPublishedNews(entries, new Date());
	return published.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
	entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const [view, allEntries] = await Promise.all([loadPublicLeagueView(), getCollection('news')]);

const relatedTeams = data.relatedTeamSlugs
	.map((slug) => view.teams.find((team) => team.slug === slug))
	.filter((team): team is NonNullable<typeof team> => Boolean(team));

const moreNews = selectPublishedNews(allEntries, new Date())
	.filter((candidate) => candidate.id !== entry.id)
	.slice(0, 3);

const hasRelatedContent = relatedTeams.length > 0 || Boolean(data.relatedMatchdayId);
const destination = NEWS_CATEGORY_DESTINATIONS[data.category];

const articleUrl = Astro.site ? new URL(`/noticias/${entry.id}`, Astro.site).href : null;
const articleStructuredData = articleUrl
	? [
			{
				'@context': 'https://schema.org',
				'@type': 'NewsArticle',
				headline: data.title,
				description: data.subtitle,
				datePublished: data.publishedAt.toISOString(),
				...(data.updatedAt ? { dateModified: data.updatedAt.toISOString() } : {}),
				url: articleUrl,
				...(data.cover ? { image: new URL(data.cover.image, Astro.site!).href } : {}),
			},
			{
				'@context': 'https://schema.org',
				'@type': 'BreadcrumbList',
				itemListElement: [
					{
						'@type': 'ListItem',
						position: 1,
						name: 'Noticias',
						item: new URL('/noticias', Astro.site!).href,
					},
					{ '@type': 'ListItem', position: 2, name: data.title, item: articleUrl },
				],
			},
		]
	: undefined;
---

<BaseLayout
	title={`${data.title} | Kings Padel League`}
	description={data.subtitle}
	image={data.cover?.image}
	imageAlt={data.cover?.alt}
	pageType="article"
	structuredData={articleStructuredData}
>
	<main id="main-content" class="public-page public-page--news-detail">
		<div class="o-container o-container--md public-page__body">
			<nav class="c-breadcrumbs" aria-label="Migas de pan">
				<a class="c-breadcrumbs__item" href="/noticias">← Todas las noticias</a>
			</nav>

			<NewsArticleContent data={data} body={{ kind: 'markdown', Content }} slug={entry.id}>
				<a
					slot="after"
					class="c-button c-button--outline news-article__destination"
					href={destination.href}
				>
					{destination.label} →
				</a>

				{
					hasRelatedContent && (
						<section
							slot="after"
							class="news-article__related"
							aria-labelledby="news-related-title"
						>
							<h2 id="news-related-title">Contenido relacionado</h2>

							{relatedTeams.length > 0 && (
								<div>
									<h3>Equipos relacionados</h3>
									<div class="news-article__related-teams">
										{relatedTeams.map((team) => (
											<TeamBadge team={team} />
										))}
									</div>
								</div>
							)}

							{data.relatedMatchdayId && (
								<a
									class="c-panel news-article__matchday"
									href={`/jornadas/${data.relatedMatchdayId}`}
								>
									Ver jornada relacionada →
								</a>
							)}
						</section>
					)
				}
			</NewsArticleContent>

			{
				moreNews.length > 0 && (
					<section class="news-article__more" aria-labelledby="news-more-title">
						<h2 id="news-more-title">Más noticias</h2>
						<div class="o-reel" aria-label="Más noticias">
							{moreNews.map((newsEntry) => (
								<NewsCard
									entry={newsEntry}
									variant={newsEntry.data.featured ? 'featured' : 'standard'}
								/>
							))}
						</div>
					</section>
				)
			}
		</div>
	</main>
</BaseLayout>
