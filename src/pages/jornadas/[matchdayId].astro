---
import EmptyState from '../../components/EmptyState.astro';
import MatchCard from '../../components/MatchCard.astro';
import PageHero from '../../components/PageHero.astro';
import SeasonReveal from '../../components/SeasonReveal.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublicPreseason, PUBLIC_SEASON_NAME } from '../../lib/league-presentation';
import type { PublicMatchday } from '../../lib/public-league';
import { loadPublicLeagueView } from '../../lib/public-view';

export async function getStaticPaths() {
	const view = await loadPublicLeagueView();
	return view.matchdays.map((matchday) => ({
		params: { matchdayId: matchday.id },
		props: { matchday },
	}));
}

interface Props {
	matchday: PublicMatchday;
}

const { matchday } = Astro.props as Props;
const preseason = isPublicPreseason();
const statusLabels = {
	completed: 'Jornada finalizada',
	current: 'Jornada en curso',
	upcoming: 'Jornada programada',
} as const;
---

<BaseLayout
	title={`${matchday.label} · ${PUBLIC_SEASON_NAME} · Kings Padel League`}
	description={`Cruces y resultados de ${matchday.label} en ${PUBLIC_SEASON_NAME}.`}
>
	<main id="main-content" class="public-page public-page--matchday-detail">
		<div class="o-container o-container--xl public-page__body">
			<nav class="c-breadcrumbs" aria-label="Migas de pan">
				<a class="c-breadcrumbs__item" href="/jornadas">← Todas las jornadas</a>
			</nav>

			<PageHero
				eyebrow={preseason ? `${PUBLIC_SEASON_NAME} · Próximamente` : statusLabels[matchday.status]}
				title={preseason ? 'Los cruces todavía no son oficiales' : matchday.label}
				description={preseason
					? 'Esta ficha queda preparada para recibir equipos, horarios, parejas y marcadores cuando se publique el calendario definitivo.'
					: 'Consulta horario, equipos, parejas inscritas y marcador oficial de cada cruce.'}
				meta={preseason
					? [PUBLIC_SEASON_NAME, 'Pretemporada', 'Publicación pendiente']
					: [
							matchday.dateLabel,
							`${matchday.encounters.length} enfrentamientos`,
							matchday.byeTeam ? `Descansa ${matchday.byeTeam.name}` : 'Todos compiten',
						]}
				mark="J"
			>
				<a slot="actions" class="c-button c-button--outline" href="/calendario">Calendario</a>
			</PageHero>

			{
				preseason ? (
					<SeasonReveal
						eyebrow="Ficha de jornada preparada"
						title="Sin cruces provisionales. Solo información oficial."
						description="Cuando la liga publique esta jornada, la misma página mostrará automáticamente equipos, horarios, parejas y resultados sin cambiar su dirección."
						items={['Horario oficial', 'Equipos y parejas', 'Marcador de jornada']}
					>
						<a class="c-button c-button--primary" href="/equipos">
							Ver equipos
						</a>
						<a class="c-button c-button--outline" href="/jornadas">
							Volver a jornadas
						</a>
					</SeasonReveal>
				) : (
					<>
						{matchday.byeTeam && (
							<aside class="bye-team-panel">
								<p class="c-eyebrow">Descansa esta jornada</p>
								<h2>{matchday.byeTeam.name}</h2>
								<p>Este equipo no disputa encuentro durante la fecha.</p>
							</aside>
						)}

						<section class="section-block" aria-labelledby="encounters-title">
							<header class="section-block__header section-block__header--editorial">
								<div>
									<p class="c-eyebrow">Programa oficial</p>
									<h2 id="encounters-title">Cruces de {matchday.label}</h2>
								</div>
								<p>Abre cada marcador para conocer el detalle de las parejas.</p>
							</header>
							{matchday.encounters.length ? (
								<div class="match-list match-list--premium">
									{matchday.encounters.map((encounter) => (
										<MatchCard encounter={encounter} showPairs />
									))}
								</div>
							) : (
								<EmptyState
									title="Cruces pendientes"
									description="Los enfrentamientos de esta jornada todavía no se han publicado."
								/>
							)}
						</section>
					</>
				)
			}
		</div>
	</main>
</BaseLayout>
