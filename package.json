{
	"name": "kings-padel-league-web",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "npm@11.12.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"overrides": {
		"path-to-regexp": "^6.3.0"
	},
	"volta": {
		"node": "24.15.0",
		"npm": "11.12.1"
	},
	"scripts": {
		"dev": "tinacms dev -c \"astro dev\"",
		"dev:fixture": "node tests/dev-with-fixture.mjs",
		"build": "tinacms build -c \"astro build\"",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check",
		"typecheck": "astro check",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:css": "stylelint \"src/**/*.css\"",
		"lint:css:fix": "stylelint \"src/**/*.css\" --fix",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:ssg": "node tests/ssg-build.mjs",
		"test:e2e": "playwright test",
		"knip": "knip",
		"architecture": "depcruise src --config .dependency-cruiser.cjs",
		"security": "npm audit --audit-level=high",
		"generate": "astro sync && tinacms build --local --skip-indexing --skip-search-index --skip-cloud-checks --noTelemetry",
		"quality": "npm run generate && npm run format:check && npm run lint && npm run lint:css && npm run typecheck && npm run knip && npm run architecture && npm run test:run && npm run test:ssg && npm run security",
		"prepare": "husky"
	},
	"dependencies": {
		"@kpl/design-system": "git+https://github.com/VicentUCF/KPL-Design-System.git#74871a429cbca165dc3c7070e1d8c4195b8c6b2a",
		"@tinacms/astro": "^0.7.0",
		"astro": "^7.2.8",
		"three": "^0.185.1",
		"tinacms": "^3.13.0"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/vercel": "^11.0.10",
		"@eslint-community/eslint-plugin-eslint-comments": "^4.8.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@tinacms/cli": "^2.7.0",
		"@types/node": "^26.4.0",
		"@types/three": "^0.185.4",
		"@vitest/coverage-v8": "^5.0.0",
		"dependency-cruiser": "^18.2.0",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^3.1.0",
		"eslint-plugin-sonarjs": "^4.2.0",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"knip": "^6.34.0",
		"lint-staged": "^17.5.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"stylelint": "^17.15.0",
		"stylelint-config-recommended": "^18.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^5.0.0"
	}
}
